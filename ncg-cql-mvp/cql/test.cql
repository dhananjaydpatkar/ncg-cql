/* ---- Score functions (authored in the Functions tab; usable in rules) ---- */
/* Age-adjusted IPI (aaIPI) - Age-adjusted International Prognostic Index for DLBCL in patients age <= 60 years. Sums Stage III-IV (1 pt), elevated LDH (1 pt), and ECOG >= 2 (1 pt). Max score: 3. */
define function Calculate_aaIPI(stagingExtent String, serumLdh String, ecogPs String) returns Integer:
  (case stagingExtent when 'stage-3-4-advanced' then 1 else 0 end)
    + (case serumLdh when 'ldh-elevated' then 1 else 0 end)
    + (case ecogPs when 'ecog-ge-2' then 1 else 0 end)

define function Classify_aaIPI(score Integer) returns String:
  case
    when score between 0 and 0 then 'low'
    when score between 1 and 1 then 'low-intermediate'
    when score between 2 and 2 then 'high-intermediate'
    when score between 3 and 3 then 'high'
    else null
  end

define "aaIPI_Score":
  if ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'dlbcl' })
    and ("AgeGroupKnown" and "AgeGroupValue" in { 'age-le-60' })
    and "StagingExtentKnown"
    and "SerumLdhKnown"
    and "EcogPsKnown"
    then Calculate_aaIPI("StagingExtentValue", "SerumLdhValue", "EcogPsValue")
    else null

define "aaIPI_RiskGroup":
  Classify_aaIPI("aaIPI_Score")

define "aaIPI_RiskLabel":
  case "aaIPI_RiskGroup"
    when 'low' then 'Low Risk (~75-80% 5-yr OS)'
    when 'low-intermediate' then 'Low-Intermediate Risk (~65-70% 5-yr OS)'
    when 'high-intermediate' then 'High-Intermediate Risk (~50-55% 5-yr OS)'
    when 'high' then 'High Risk (~35-45% 5-yr OS)'
    else null
  end

/* International Prognostic Index (IPI) - Standard IPI for DLBCL (all ages). Sums Age > 60 (1 pt), Stage III-IV (1 pt), elevated LDH (1 pt), ECOG >= 2 (1 pt), Extranodal > 1 site (1 pt). Max: 5. */
define function Calculate_IPI(ageGroup String, stagingExtent String, serumLdh String, ecogPs String, extranodalSites String) returns Integer:
  (case ageGroup when 'age-gt-60' then 1 when 'age-ge-70' then 1 else 0 end)
    + (case stagingExtent when 'stage-3-4-advanced' then 1 else 0 end)
    + (case serumLdh when 'ldh-elevated' then 1 else 0 end)
    + (case ecogPs when 'ecog-ge-2' then 1 else 0 end)
    + (case extranodalSites when 'extranodal-gt-1' then 1 else 0 end)

define function Classify_IPI(score Integer) returns String:
  case
    when score between 0 and 1 then 'low'
    when score between 2 and 2 then 'low-intermediate'
    when score between 3 and 3 then 'high-intermediate'
    when score between 4 and 5 then 'high'
    else null
  end

define "IPI_Score":
  if ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'dlbcl' })
    and "AgeGroupKnown"
    and "StagingExtentKnown"
    and "SerumLdhKnown"
    and "EcogPsKnown"
    and "ExtranodalSitesKnown"
    then Calculate_IPI("AgeGroupValue", "StagingExtentValue", "SerumLdhValue", "EcogPsValue", "ExtranodalSitesValue")
    else null

define "IPI_RiskGroup":
  Classify_IPI("IPI_Score")

define "IPI_RiskLabel":
  case "IPI_RiskGroup"
    when 'low' then 'Low Risk (~75-80% 5-yr OS)'
    when 'low-intermediate' then 'Low-Intermediate Risk (~65-70% 5-yr OS)'
    when 'high-intermediate' then 'High-Intermediate Risk (~50-55% 5-yr OS)'
    when 'high' then 'High Risk (~35-45% 5-yr OS)'
    else null
  end

/* Follicular Lymphoma International Prognostic Index (FLIPI) - Prognostic index for Follicular Lymphoma. Sums Age > 60 (1 pt), Stage III-IV (1 pt), Hb < 12 g/dL (1 pt), Nodal sites > 4 (1 pt), LDH > ULN (1 pt). Max: 5. */
define function Calculate_FLIPI(ageGroup String, stagingExtent String, hemoglobinLevel String, nodalSitesCount String, serumLdh String) returns Integer:
  (case ageGroup when 'age-gt-60' then 1 when 'age-ge-70' then 1 else 0 end)
    + (case stagingExtent when 'stage-3-4-advanced' then 1 else 0 end)
    + (case hemoglobinLevel when 'hb-lt-12' then 1 when 'hb-lt-10-5' then 1 else 0 end)
    + (case nodalSitesCount when 'nodal-sites-gt-4' then 1 else 0 end)
    + (case serumLdh when 'ldh-elevated' then 1 else 0 end)

define function Classify_FLIPI(score Integer) returns String:
  case
    when score between 0 and 1 then 'low'
    when score between 2 and 2 then 'intermediate'
    when score between 3 and 5 then 'high'
    else null
  end

define "FLIPI_Score":
  if ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'fl' })
    and "AgeGroupKnown"
    and "StagingExtentKnown"
    and "HemoglobinLevelKnown"
    and "NodalSitesCountKnown"
    and "SerumLdhKnown"
    then Calculate_FLIPI("AgeGroupValue", "StagingExtentValue", "HemoglobinLevelValue", "NodalSitesCountValue", "SerumLdhValue")
    else null

define "FLIPI_RiskGroup":
  Classify_FLIPI("FLIPI_Score")

define "FLIPI_RiskLabel":
  case "FLIPI_RiskGroup"
    when 'low' then 'Low Risk (~91% 5-yr OS)'
    when 'intermediate' then 'Intermediate Risk (~78% 5-yr OS)'
    when 'high' then 'High Risk (~53% 5-yr OS)'
    else null
  end

/* CLL International Prognostic Index (CLL-IPI) - Prognostic scoring for CLL: TP53 del/mut (4 pts), IGHV unmutated (2 pts), B2M > 3.5 mg/L (2 pts), Stage III-IV (1 pt), Age > 65 (1 pt). Max: 10. */
define function Calculate_CLLIPI(tp53Status String, igvhStatus String, b2mLevel String, stagingExtent String, ageGroup String) returns Integer:
  (case tp53Status when 'tp53-aberrant' then 4 else 0 end)
    + (case igvhStatus when 'igvh-unmutated' then 2 else 0 end)
    + (case b2mLevel when 'b2m-elevated' then 2 else 0 end)
    + (case stagingExtent when 'stage-3-4-advanced' then 1 else 0 end)
    + (case ageGroup when 'age-gt-60' then 1 when 'age-ge-70' then 1 else 0 end)

define function Classify_CLLIPI(score Integer) returns String:
  case
    when score between 0 and 1 then 'low'
    when score between 2 and 3 then 'intermediate'
    when score between 4 and 6 then 'high'
    when score between 7 and 10 then 'very-high'
    else null
  end

define "CLLIPI_Score":
  if ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'cll-sll' })
    and "Tp53StatusKnown"
    and "IgvhStatusKnown"
    and "B2mLevelKnown"
    and "StagingExtentKnown"
    and "AgeGroupKnown"
    then Calculate_CLLIPI("Tp53StatusValue", "IgvhStatusValue", "B2mLevelValue", "StagingExtentValue", "AgeGroupValue")
    else null

define "CLLIPI_RiskGroup":
  Classify_CLLIPI("CLLIPI_Score")

define "CLLIPI_RiskLabel":
  case "CLLIPI_RiskGroup"
    when 'low' then 'Low Risk (~93% 5-yr OS)'
    when 'intermediate' then 'Intermediate Risk (~79% 5-yr OS)'
    when 'high' then 'High Risk (~64% 5-yr OS)'
    when 'very-high' then 'Very High Risk (~23% 5-yr OS)'
    else null
  end

/* MCL International Prognostic Index (MIPI) - Simplified MIPI for Mantle Cell Lymphoma. Evaluates Age, ECOG, LDH, and WBC count. Max: 11. */
define function Calculate_MIPI(ageGroup String, ecogPs String, serumLdh String, wbcCount String) returns Integer:
  (case ageGroup when 'age-gt-60' then 2 when 'age-ge-70' then 3 else 0 end)
    + (case ecogPs when 'ecog-ge-2' then 2 else 0 end)
    + (case serumLdh when 'ldh-elevated' then 2 else 0 end)
    + (case wbcCount when 'wbc-ge-10' then 2 when 'wbc-ge-15' then 2 else 0 end)

define function Classify_MIPI(score Integer) returns String:
  case
    when score between 0 and 3 then 'low'
    when score between 4 and 5 then 'intermediate'
    when score between 6 and 11 then 'high'
    else null
  end

define "MIPI_Score":
  if ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'mcl' })
    and "AgeGroupKnown"
    and "EcogPsKnown"
    and "SerumLdhKnown"
    and "WbcCountKnown"
    then Calculate_MIPI("AgeGroupValue", "EcogPsValue", "SerumLdhValue", "WbcCountValue")
    else null

define "MIPI_RiskGroup":
  Classify_MIPI("MIPI_Score")

define "MIPI_RiskLabel":
  case "MIPI_RiskGroup"
    when 'low' then 'Low Risk (Median OS not reached)'
    when 'intermediate' then 'Intermediate Risk (Median OS ~51 mo)'
    when 'high' then 'High Risk (Median OS ~29 mo)'
    else null
  end

/* International Prognostic Score (IPS) - IPS for Hodgkin Lymphoma: Albumin < 4 (1 pt), Hb < 10.5 (1 pt), Stage IV (1 pt), Age >= 45 (1 pt), WBC >= 15 (1 pt). Max: 5. */
define function Calculate_IPS(serumAlbumin String, hemoglobinLevel String, stagingExtent String, ageGroup String, wbcCount String) returns Integer:
  (case serumAlbumin when 'albumin-low' then 1 else 0 end)
    + (case hemoglobinLevel when 'hb-lt-10-5' then 1 else 0 end)
    + (case stagingExtent when 'stage-3-4-advanced' then 1 else 0 end)
    + (case ageGroup when 'age-gt-60' then 1 when 'age-ge-70' then 1 else 0 end)
    + (case wbcCount when 'wbc-ge-15' then 1 else 0 end)

define function Classify_IPS(score Integer) returns String:
  case
    when score between 0 and 0 then 'score-0'
    when score between 1 and 1 then 'score-1'
    when score between 2 and 2 then 'score-2'
    when score between 3 and 3 then 'score-3'
    when score between 4 and 4 then 'score-4'
    when score between 5 and 7 then 'score-high'
    else null
  end

define "IPS_Score":
  if ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'hl' })
    and "SerumAlbuminKnown"
    and "HemoglobinLevelKnown"
    and "StagingExtentKnown"
    and "AgeGroupKnown"
    and "WbcCountKnown"
    then Calculate_IPS("SerumAlbuminValue", "HemoglobinLevelValue", "StagingExtentValue", "AgeGroupValue", "WbcCountValue")
    else null

define "IPS_RiskGroup":
  Classify_IPS("IPS_Score")

define "IPS_RiskLabel":
  case "IPS_RiskGroup"
    when 'score-0' then 'Score 0 (~84% 5-yr FFP)'
    when 'score-1' then 'Score 1 (~77% 5-yr FFP)'
    when 'score-2' then 'Score 2 (~67% 5-yr FFP)'
    when 'score-3' then 'Score 3 (~60% 5-yr FFP)'
    when 'score-4' then 'Score 4 (~51% 5-yr FFP)'
    when 'score-high' then 'Score >= 5 (~42% 5-yr FFP)'
    else null
  end

/* MALT-IPI - Marginal Zone / MALT International Prognostic Index. Sums Age >= 70 (1 pt), Stage III-IV (1 pt), LDH > ULN (1 pt). Max: 3. */
define function Calculate_MALT_IPI(ageGroup String, stagingExtent String, serumLdh String) returns Integer:
  (case ageGroup when 'age-ge-70' then 1 else 0 end)
    + (case stagingExtent when 'stage-3-4-advanced' then 1 else 0 end)
    + (case serumLdh when 'ldh-elevated' then 1 else 0 end)

define function Classify_MALT_IPI(score Integer) returns String:
  case
    when score between 0 and 0 then 'low'
    when score between 1 and 1 then 'intermediate'
    when score between 2 and 3 then 'high'
    else null
  end

define "MALT_IPI_Score":
  if ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'mzl' })
    and "AgeGroupKnown"
    and "StagingExtentKnown"
    and "SerumLdhKnown"
    then Calculate_MALT_IPI("AgeGroupValue", "StagingExtentValue", "SerumLdhValue")
    else null

define "MALT_IPI_RiskGroup":
  Classify_MALT_IPI("MALT_IPI_Score")

define "MALT_IPI_RiskLabel":
  case "MALT_IPI_RiskGroup"
    when 'low' then 'Low Risk (~70% 5-yr PFS)'
    when 'intermediate' then 'Intermediate Risk (~56% 5-yr PFS)'
    when 'high' then 'High Risk (~29% 5-yr PFS)'
    else null
  end

/* Prognostic Index for PTCL (PIT) - Prognostic scoring for Peripheral T-Cell Lymphoma. Age > 60 (1 pt), ECOG >= 2 (1 pt), LDH > ULN (1 pt), Bone marrow involvement (1 pt). Max: 4. */
define function Calculate_PIT(ageGroup String, ecogPs String, serumLdh String, boneMarrowStatus String) returns Integer:
  (case ageGroup when 'age-gt-60' then 1 when 'age-ge-70' then 1 else 0 end)
    + (case ecogPs when 'ecog-ge-2' then 1 else 0 end)
    + (case serumLdh when 'ldh-elevated' then 1 else 0 end)
    + (case boneMarrowStatus when 'bm-positive' then 1 else 0 end)

define function Classify_PIT(score Integer) returns String:
  case
    when score between 0 and 0 then 'group-1'
    when score between 1 and 1 then 'group-2'
    when score between 2 and 2 then 'group-3'
    when score between 3 and 4 then 'group-4'
    else null
  end

define "PIT_Score":
  if ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'ptcl' })
    and "AgeGroupKnown"
    and "EcogPsKnown"
    and "SerumLdhKnown"
    and "BoneMarrowStatusKnown"
    then Calculate_PIT("AgeGroupValue", "EcogPsValue", "SerumLdhValue", "BoneMarrowStatusValue")
    else null

define "PIT_RiskGroup":
  Classify_PIT("PIT_Score")

define "PIT_RiskLabel":
  case "PIT_RiskGroup"
    when 'group-1' then 'Group 1 (0 adverse factors) (~62% 5-yr OS)'
    when 'group-2' then 'Group 2 (1 adverse factor) (~53% 5-yr OS)'
    when 'group-3' then 'Group 3 (2 adverse factors) (~33% 5-yr OS)'
    when 'group-4' then 'Group 4 (3-4 adverse factors) (~18% 5-yr OS)'
    else null
  end

/* ---- Rules (evaluated in order; first match wins) ---- */
/* Missing or unparsed smear/presentation */
define "Rule1_MissingOrUnparsedSmearPresentation":
  not "PresentationSmearKnown"

/* Missing or unparsed lymphoma subtype */
define "Rule2_MissingOrUnparsedLymphomaSubtype":
  not "LymphomaCategoryKnown"

/* Hepatitis B positive requiring antiviral prophylaxis */
define "Rule3_HepatitisBPositiveRequiringAntiviralProp":
  ("ViralScreeningHbvKnown" and "ViralScreeningHbvValue" in { 'hbv-positive' })

/* Hepatitis C positive requiring HCV RNA and hepatology referral */
define "Rule4_HepatitisCPositiveRequiringHcvRnaAndHepa":
  ("ViralScreeningHcvKnown" and "ViralScreeningHcvValue" in { 'hcv-positive' })

/* HIV positive requiring viral load, CD4 count, and OI prophylaxis */
define "Rule5_HivPositiveRequiringViralLoadCd4CountAnd":
  ("ViralScreeningHivKnown" and "ViralScreeningHivValue" in { 'hiv-positive' })

/* High metabolic risk requiring Tumor Lysis Syndrome prophylaxis */
define "Rule6_HighMetabolicRiskRequiringTumorLysisSynd":
  ("TlsMetabolicRiskKnown" and "TlsMetabolicRiskValue" in { 'tls-high-risk' })

/* Circulating lymphocytosis present on smear */
define "Rule7_CirculatingLymphocytosisPresentOnSmear":
  ("PresentationSmearKnown" and "PresentationSmearValue" in { 'lymphocytosis-present' })

/* Solid mass without lymphocytosis (biopsy needed) */
define "Rule8_SolidMassWithoutLymphocytosisBiopsyNeede":
  ("PresentationSmearKnown" and "PresentationSmearValue" in { 'no-lymphocytosis' })
    and not "StagingExtentKnown"

/* Double-Hit Lymphoma confirmed (DA-EPOCH-R protocol) */
define "Rule9_DoubleHitLymphomaConfirmedDaEpochRProtoc":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'dlbcl' })
    and ("DoubleHitFishKnown" and "DoubleHitFishValue" in { 'dhl-detected' })

/* Asymptomatic CLL without treatment indication */
define "Rule10_AsymptomaticCllWithoutTreatmentIndicatio":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'cll-sll' })
    and ("CllTherapyIndicationKnown" and "CllTherapyIndicationValue" in { 'asymptomatic-no-therapy' })

/* CLL with treatment indicated */
define "Rule11_CllWithTreatmentIndicated":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'cll-sll' })
    and ("CllTherapyIndicationKnown" and "CllTherapyIndicationValue" in { 'therapy-indicated' })

/* Marginal Zone Lymphoma (MALT / SMZL) */
define "Rule12_MarginalZoneLymphomaMaltSmzl":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'mzl' })

/* Cutaneous T-Cell Lymphoma (MF / Sézary) */
define "Rule13_CutaneousTCellLymphomaMfSZary":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'ctcl-mf' })

/* DLBCL or MCL with CNS high-risk anatomical features */
define "Rule14_DlbclOrMclWithCnsHighRiskAnatomicalFeatu":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'dlbcl', 'mcl' })
    and ("CnsRiskFactorsKnown" and "CnsRiskFactorsValue" in { 'cns-high-risk' })

/* High-dose Methotrexate planned requiring DTPA-GFR renal clearance */
define "Rule15_HighDoseMethotrexatePlannedRequiringDtpa":
  ("PlannedTherapyCardiacKnown" and "PlannedTherapyCardiacValue" in { 'high-dose-mtx-planned' })

/* Limited-stage DLBCL or Hodgkin Lymphoma on PET-CT (omit marrow) */
define "Rule16_LimitedStageDlbclOrHodgkinLymphomaOnPetC":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'dlbcl', 'hl' })
    and ("StagingExtentKnown" and "StagingExtentValue" in { 'stage-1-2-limited' })

/* Low-grade lymphomas, MCL, Burkitt, PTCL (PET-CT + BM required) */
define "Rule17_LowGradeLymphomasMclBurkittPtclPetCtBmRe":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'fl', 'mcl', 'ptcl', 'burkitt-hbl', 'hcl-lpl' })

/* Advanced DLBCL (Age <= 60) with high aaIPI score (>= 2) */
define "Rule18_AdvancedDlbclAge60WithHighAaipiScore2":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'dlbcl' })
    and ("StagingExtentKnown" and "StagingExtentValue" in { 'stage-3-4-advanced' })
    and ("aaIPI_Score" >= 2)

/* Advanced DLBCL standard risk (PET-CT staging) */
define "Rule19_AdvancedDlbclStandardRiskPetCtStaging":
  ("LymphomaCategoryKnown" and "LymphomaCategoryValue" in { 'dlbcl' })
    and ("StagingExtentKnown" and "StagingExtentValue" in { 'stage-3-4-advanced' })

/* ---- Treatment group ---- */
define "TreatmentGroup":
  case
    when "Rule1_MissingOrUnparsedSmearPresentation" then 'needs-review'
    when "Rule2_MissingOrUnparsedLymphomaSubtype" then 'needs-review'
    when "Rule3_HepatitisBPositiveRequiringAntiviralProp" then 'pathway-viral-prophylaxis-hbv'
    when "Rule4_HepatitisCPositiveRequiringHcvRnaAndHepa" then 'pathway-viral-prophylaxis-hcv'
    when "Rule5_HivPositiveRequiringViralLoadCd4CountAnd" then 'pathway-hiv-multidisciplinary'
    when "Rule6_HighMetabolicRiskRequiringTumorLysisSynd" then 'pathway-tls-prophylaxis'
    when "Rule7_CirculatingLymphocytosisPresentOnSmear" then 'pathway-flow-cytometry-clpd'
    when "Rule8_SolidMassWithoutLymphocytosisBiopsyNeede" then 'pathway-tissue-excision-biopsy'
    when "Rule9_DoubleHitLymphomaConfirmedDaEpochRProtoc" then 'pathway-double-hit-specialized'
    when "Rule10_AsymptomaticCllWithoutTreatmentIndicatio" then 'pathway-staging-cll-surveillance'
    when "Rule11_CllWithTreatmentIndicated" then 'pathway-staging-cll-pretherapy'
    when "Rule12_MarginalZoneLymphomaMaltSmzl" then 'pathway-staging-mzl-cect'
    when "Rule13_CutaneousTCellLymphomaMfSZary" then 'pathway-cutaneous-tcell-staging'
    when "Rule14_DlbclOrMclWithCnsHighRiskAnatomicalFeatu" then 'pathway-cns-staging-and-cardiac'
    when "Rule15_HighDoseMethotrexatePlannedRequiringDtpa" then 'pathway-high-dose-mtx-dtpa'
    when "Rule16_LimitedStageDlbclOrHodgkinLymphomaOnPetC" then 'pathway-staging-pet-ct-omit-bm'
    when "Rule17_LowGradeLymphomasMclBurkittPtclPetCtBmRe" then 'pathway-staging-pet-ct-and-bm'
    when "Rule18_AdvancedDlbclAge60WithHighAaipiScore2" then 'pathway-staging-pet-ct-omit-bm'
    when "Rule19_AdvancedDlbclStandardRiskPetCtStaging" then 'pathway-staging-pet-ct-omit-bm'
    else 'needs-review'
  end

/* ---- Recommended regimens ---- */
define "RecommendedRegimens":
  case "TreatmentGroup"
    when 'pathway-viral-prophylaxis-hbv' then { 'Quantitative HBV DNA PCR test', 'Initiate prophylactic antiviral therapy (Entecavir 0.5 mg daily or Tenofovir)', 'Continue antiviral prophylaxis during and for at least 12 months post-chemotherapy', 'LFT monitoring every 4-6 weeks' }
    when 'pathway-viral-prophylaxis-hcv' then { 'Quantitative HCV RNA by RT-PCR', 'Gastroenterology / Hepatology referral before systemic therapy', 'Coordinate Direct-Acting Antiviral (DAA) therapy' }
    when 'pathway-hiv-multidisciplinary' then { 'CD4 cell count and HIV-1 RNA viral load', 'Opportunistic infection (OI) assessment and prophylaxis (PJP, MAC, Fungal)', 'Coordinate with HIV specialist; avoid myelosuppressive antiretroviral agents' }
    when 'pathway-tls-prophylaxis' then { 'Aggressive intravenous hydration (2.5-3 L/m2/day) with strict I/O monitoring', 'Rasburicase (0.2 mg/kg IV) for hyperuricemia or Allopurinol for moderate risk', 'Serum electrolytes, Ca, Phos, Uric acid, Creatinine, LDH Q6-12h' }
    when 'pathway-double-hit-specialized' then { 'Dose-adjusted EPOCH-R (DA-EPOCH-R) regimen', 'Diagnostic LP and CNS-directed prophylaxis (IT methotrexate / cytarabine)', 'Evaluate for autologous or allogeneic stem cell transplantation in CR1' }
    when 'pathway-flow-cytometry-clpd' then { 'Flow cytometry CLPD panel (CD5, CD10, CD19, CD20, CD23, CD22, FMC7, CD200, Cyclin D1)', 'Subtype differentiation (CLL vs MCL vs FL vs SMZL vs HCL vs T/NK-CLPD)', 'Omit initial lymph node biopsy and routine bone marrow examination' }
    when 'pathway-tissue-excision-biopsy' then { 'Excision biopsy of largest accessible lymph node (preferred over FNA/core)', 'Comprehensive lymphoma IHC panel (B-cell, T-cell, proliferation markers)', 'Image-guided core needle biopsy (USG/CT) if nodes are deep/internal or surgery contraindicated' }
    when 'pathway-staging-pet-ct-and-bm' then { 'Whole-body 18F-FDG PET-CT (skull base to mid-thigh)', 'Bone marrow aspiration + imprint + trephine biopsy', 'Flow cytometry and cytogenetics on bone marrow aspirate' }
    when 'pathway-staging-pet-ct-omit-bm' then { 'Whole-body 18F-FDG PET-CT', 'Omit routine bone marrow biopsy (PET-CT sufficient)', 'Calculate disease-specific prognostic index (aaIPI / IPI / IPS)' }
    when 'pathway-staging-cll-surveillance' then { 'CXR PA view + Ultrasound abdomen and pelvis', 'Omit CT chest/abdomen/pelvis and omit bone marrow biopsy', 'Active clinical and haematological surveillance (every 3-6 months)' }
    when 'pathway-staging-cll-pretherapy' then { 'CECT chest + abdomen + pelvis', 'Bone marrow aspirate & trephine biopsy (for cytopenias / reserve assessment)', 'CLL FISH panel (del 17p, 11q, 13q, +12) + TP53 mutation + IgVH status', 'Calculate CLL-IPI prognostic score' }
    when 'pathway-staging-mzl-cect' then { 'CECT chest + abdomen + pelvis', 'Serum Protein Electrophoresis (SPEP) for paraprotein / immunoglobulin spike', 'Bone marrow aspirate and trephine biopsy', 't(11;18) translocation FISH if gastric MALT (predicts H. pylori resistance)' }
    when 'pathway-cns-staging-and-cardiac' then { 'Diagnostic Lumbar Puncture: CSF cytology + flow cytometry', 'Brain MRI with contrast (if neurological symptoms or PCNSL suspected)', '2D-Echocardiography (LVEF assessment) prior to anthracycline therapy', 'Plan CNS-directed prophylaxis (intrathecal MTX or systemic high-dose MTX)' }
    when 'pathway-cutaneous-tcell-staging' then { 'Skin biopsy (punch or incisional, mandatory for histopathology + TCR clonality)', 'Clinical skin staging (mSWAT score for early plaque disease)', 'CECT chest + abdomen + pelvis if nodular, extensive skin disease, or Sézary cells', 'Peripheral blood smear review for cerebriform Sézary cells' }
    when 'pathway-high-dose-mtx-dtpa' then { '99mTc-DTPA GFR clearance test (mandatory before high-dose MTX if age > 40)', 'Hydration and urine alkalinization protocol (target urinary pH >= 7.0)', 'Leucovorin rescue planning and methotrexate serum drug level monitoring' }
    else { }
  end

/* ---- Advanced custom CQL definitions ---- */
/* HCV RNA confirmation trigger: mandatory before systemic therapy if Anti-HCV is reactive */
define function Requires_HCV_RNA(hcvStatus String) returns Boolean:
  hcvStatus in { 'hcv-positive' }

/* HIV multidisciplinary staging trigger: mandatory CD4, viral load, and OI prophylaxis if HIV reactive */
define function Requires_HIV_Staging(hivStatus String) returns Boolean:
  hivStatus in { 'hiv-positive' }

/* Double-Hit Lymphoma triage: verifies GCB-DLBCL with MYC and BCL2/6 rearrangements */
define function Requires_DoubleHit_FISH(subtype String, doubleHitStatus String) returns Boolean:
  subtype in { 'dlbcl' } and doubleHitStatus in { 'dhl-detected' }

/* Renal clearance trigger: mandatory 99mTc-DTPA GFR if high-dose methotrexate is planned and age > 40 */
define function Requires_DTPA_GFR(plannedTherapy String, ageGroup String) returns Boolean:
  plannedTherapy in { 'high-dose-mtx-planned' } and ageGroup in { 'age-gt-60', 'age-ge-70' }

/* Tumor Lysis Syndrome prophylaxis trigger: indicates aggressive IV hydration and rasburicase/allopurinol */
define function Requires_TLS_Prophylaxis(tlsRisk String) returns Boolean:
  tlsRisk in { 'tls-high-risk' }
