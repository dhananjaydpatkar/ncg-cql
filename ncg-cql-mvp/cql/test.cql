codesystem "EcogPsCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-ecog-ps'
codesystem "SerumLdhCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-serum-ldh'
codesystem "ExtranodalSitesCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-extranodal-sites'
codesystem "HemoglobinLevelCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-hemoglobin-level'
codesystem "WbcCountCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-wbc-count'
codesystem "SerumAlbuminCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-serum-albumin'
codesystem "B2mLevelCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-b2m-level'
codesystem "Tp53StatusCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-tp53-status'
codesystem "IgvhStatusCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-igvh-status'
codesystem "BoneMarrowStatusCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-bone-marrow-status'
codesystem "NodalSitesCountCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-nodal-sites-count'

code "PresentationSmear_LymphocytosisPresent": 'lymphocytosis-present' from "PresentationSmearCS" display 'Lymphocytosis present (circulating abnormal cells)'
code "PresentationSmear_NoLymphocytosis": 'no-lymphocytosis' from "PresentationSmearCS" display 'No lymphocytosis (solid nodal / extranodal mass)'
code "LymphomaCategory_CllSll": 'cll-sll' from "LymphomaCategoryCS" display 'CLL / SLL (Chronic lymphocytic leukemia)'
code "LymphomaCategory_Mcl": 'mcl' from "LymphomaCategoryCS" display 'Mantle cell lymphoma (MCL)'
code "LymphomaCategory_Fl": 'fl' from "LymphomaCategoryCS" display 'Follicular lymphoma (FL)'
code "LymphomaCategory_Mzl": 'mzl' from "LymphomaCategoryCS" display 'Marginal zone lymphoma (MZL / MALT / SMZL)'
code "LymphomaCategory_Dlbcl": 'dlbcl' from "LymphomaCategoryCS" display 'Diffuse large B-cell lymphoma (DLBCL)'
code "LymphomaCategory_Hl": 'hl' from "LymphomaCategoryCS" display 'Classical Hodgkin lymphoma (cHL)'
code "LymphomaCategory_Ptcl": 'ptcl' from "LymphomaCategoryCS" display 'Peripheral T-cell lymphoma (PTCL)'
code "LymphomaCategory_CtclMf": 'ctcl-mf' from "LymphomaCategoryCS" display 'Cutaneous T-cell lymphoma (MF / Sézary)'
code "LymphomaCategory_BurkittHbl": 'burkitt-hbl' from "LymphomaCategoryCS" display 'Burkitt / High-grade B-cell lymphoma'
code "LymphomaCategory_HclLpl": 'hcl-lpl' from "LymphomaCategoryCS" display 'Hairy cell leukemia / LPL / Waldenström'
code "CllTherapyIndication_AsymptomaticNoTherapy": 'asymptomatic-no-therapy' from "CllTherapyIndicationCS" display 'Asymptomatic / stable (no indication for therapy)'
code "CllTherapyIndication_TherapyIndicated": 'therapy-indicated' from "CllTherapyIndicationCS" display 'Symptomatic / cytopenias / treatment indicated'
code "CllTherapyIndication_NotApplicable": 'not-applicable' from "CllTherapyIndicationCS" display 'Not applicable (non-CLL subtype)'
code "StagingExtent_Stage12Limited": 'stage-1-2-limited' from "StagingExtentCS" display 'Limited stage (Stage I-II)'
code "StagingExtent_Stage34Advanced": 'stage-3-4-advanced' from "StagingExtentCS" display 'Advanced stage (Stage III-IV)'
code "StagingExtent_MfEarlyPlaques": 'mf-early-plaques' from "StagingExtentCS" display 'Early Mycosis Fungoides (thin plaques only)'
code "StagingExtent_MfExtensiveTumour": 'mf-extensive-tumour' from "StagingExtentCS" display 'MF extensive / nodular plaques / Sézary cells'
code "CnsRiskFactors_CnsHighRisk": 'cns-high-risk' from "CnsRiskFactorsCS" display 'High-risk CNS features present'
code "CnsRiskFactors_CnsStandardRisk": 'cns-standard-risk' from "CnsRiskFactorsCS" display 'Standard risk / no high-risk CNS features'
code "PlannedTherapyCardiac_AnthracyclinePlanned": 'anthracycline-planned' from "PlannedTherapyCardiacCS" display 'Anthracycline planned (CHOP/ABVD) or cardiac comorbidity'
code "PlannedTherapyCardiac_HighDoseMtxPlanned": 'high-dose-mtx-planned' from "PlannedTherapyCardiacCS" display 'High-dose Methotrexate planned (age >40 or renal risk)'
code "PlannedTherapyCardiac_OtherSystemicTherapy": 'other-systemic-therapy' from "PlannedTherapyCardiacCS" display 'Other standard therapy / low cardiac risk'
code "ViralScreeningHbv_HbvPositive": 'hbv-positive' from "ViralScreeningHbvCS" display 'HBsAg or HBcAb-IgG positive'
code "ViralScreeningHbv_HbvNegative": 'hbv-negative' from "ViralScreeningHbvCS" display 'HBsAg and HBcAb-IgG negative'
code "ViralScreeningHcv_HcvPositive": 'hcv-positive' from "ViralScreeningHcvCS" display 'Anti-HCV antibody reactive'
code "ViralScreeningHcv_HcvNegative": 'hcv-negative' from "ViralScreeningHcvCS" display 'Anti-HCV antibody negative'
code "ViralScreeningHiv_HivPositive": 'hiv-positive' from "ViralScreeningHivCS" display 'HIV-1/2 reactive'
code "ViralScreeningHiv_HivNegative": 'hiv-negative' from "ViralScreeningHivCS" display 'HIV-1/2 non-reactive'
code "TlsMetabolicRisk_TlsHighRisk": 'tls-high-risk' from "TlsMetabolicRiskCS" display 'High TLS risk (bulky disease, elevated uric acid / LDH)'
code "TlsMetabolicRisk_TlsStandardRisk": 'tls-standard-risk' from "TlsMetabolicRiskCS" display 'Standard / low TLS risk'
code "DoubleHitFish_DhlDetected": 'dhl-detected' from "DoubleHitFishCS" display 'Double-hit / Triple-hit confirmed (MYC + BCL2/6 rearrangement)'
code "DoubleHitFish_DhlNegative": 'dhl-negative' from "DoubleHitFishCS" display 'Standard GCB-DLBCL (MYC rearrangement negative)'
code "DoubleHitFish_NotApplicable": 'not-applicable' from "DoubleHitFishCS" display 'Not applicable / non-DLBCL'
code "AgeGroup_AgeLe60": 'age-le-60' from "AgeGroupCS" display 'Age <= 60 years (aaIPI candidate)'
code "AgeGroup_AgeGt60": 'age-gt-60' from "AgeGroupCS" display 'Age 61-69 years (standard IPI / FLIPI / IPS)'
code "AgeGroup_AgeGe70": 'age-ge-70' from "AgeGroupCS" display 'Age >= 70 years (MIPI / MALT-IPI adverse)'
code "EcogPs_Ecog01": 'ecog-0-1' from "EcogPsCS" display 'ECOG 0-1 (fully active / light work)'
code "EcogPs_EcogGe2": 'ecog-ge-2' from "EcogPsCS" display 'ECOG >= 2 (capable of self-care / bedbound > 50%)'
code "SerumLdh_LdhNormal": 'ldh-normal' from "SerumLdhCS" display 'Normal (<= ULN)'
code "SerumLdh_LdhElevated": 'ldh-elevated' from "SerumLdhCS" display 'Elevated (> ULN)'
code "ExtranodalSites_Extranodal01": 'extranodal-0-1' from "ExtranodalSitesCS" display '0 or 1 extranodal site'
code "ExtranodalSites_ExtranodalGt1": 'extranodal-gt-1' from "ExtranodalSitesCS" display '> 1 extranodal site'
code "HemoglobinLevel_HbNormal": 'hb-normal' from "HemoglobinLevelCS" display 'Hb >= 12.0 g/dL (normal)'
code "HemoglobinLevel_HbLt12": 'hb-lt-12' from "HemoglobinLevelCS" display 'Hb < 12.0 g/dL (FLIPI adverse)'
code "HemoglobinLevel_HbLt105": 'hb-lt-10-5' from "HemoglobinLevelCS" display 'Hb < 10.5 g/dL (IPS adverse)'
code "WbcCount_WbcNormal": 'wbc-normal' from "WbcCountCS" display 'WBC < 10.0 x 10^9/L (normal)'
code "WbcCount_WbcGe10": 'wbc-ge-10' from "WbcCountCS" display 'WBC >= 10.0 x 10^9/L (MIPI adverse)'
code "WbcCount_WbcGe15": 'wbc-ge-15' from "WbcCountCS" display 'WBC >= 15.0 x 10^9/L (IPS adverse)'
code "SerumAlbumin_AlbuminNormal": 'albumin-normal' from "SerumAlbuminCS" display 'Albumin >= 4.0 g/dL (normal)'
code "SerumAlbumin_AlbuminLow": 'albumin-low' from "SerumAlbuminCS" display 'Albumin < 4.0 g/dL (IPS adverse)'
code "B2mLevel_B2mNormal": 'b2m-normal' from "B2mLevelCS" display 'Normal (<= 3.5 mg/L)'
code "B2mLevel_B2mElevated": 'b2m-elevated' from "B2mLevelCS" display 'Elevated (> 3.5 mg/L in CLL-IPI / > ULN)'
code "Tp53Status_Tp53WildType": 'tp53-wild-type' from "Tp53StatusCS" display 'TP53 wild-type / negative'
code "Tp53Status_Tp53Aberrant": 'tp53-aberrant' from "Tp53StatusCS" display 'TP53 mutated or 17p deletion present (high risk)'
code "IgvhStatus_IgvhMutated": 'igvh-mutated' from "IgvhStatusCS" display 'IGHV mutated (< 98% homology, favorable)'
code "IgvhStatus_IgvhUnmutated": 'igvh-unmutated' from "IgvhStatusCS" display 'IGHV unmutated (>= 98% homology, adverse)'
code "BoneMarrowStatus_BmNegative": 'bm-negative' from "BoneMarrowStatusCS" display 'Bone marrow uninvolved / negative'
code "BoneMarrowStatus_BmPositive": 'bm-positive' from "BoneMarrowStatusCS" display 'Bone marrow involved / positive'
code "NodalSitesCount_NodalSitesLe4": 'nodal-sites-le-4' from "NodalSitesCountCS" display '<= 4 nodal areas involved'
code "NodalSitesCount_NodalSitesGt4": 'nodal-sites-gt-4' from "NodalSitesCountCS" display '> 4 nodal areas involved (FLIPI adverse)'

context Patient

/* ---- Findings: one observation per finding, with provenance gate ---- */
define "PresentationSmearObservation":
  singleton from ([Observation: "PresentationSmear_LymphocytosisPresent"]
    union [Observation: "PresentationSmear_NoLymphocytosis"])

define "PresentationSmearKnown":
