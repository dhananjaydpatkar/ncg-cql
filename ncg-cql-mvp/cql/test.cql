using FHIR version '4.0.1'

include FHIRHelpers version '4.0.1' called FHIRHelpers
include NCGCommon version '0.1.0' called NCGCommon

codesystem "PresentationSmearCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-presentation-smear'
codesystem "LymphomaCategoryCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-lymphoma-category'
