library NCG_FL_2020 version '0.2.0'

/*
 * Follicular Lymphoma - first-line treatment pathway
 * Source: Follicular Lymphoma Treatment Workflow; Lymphoma Workup Flowchart
 * Organization: Hematology-Oncology Clinical Working Group
 * Status: DRAFT
 * Generated by Clinical Guideline Studio. Do not edit by hand - edit the guideline instead.
 */

using FHIR version '4.0.1'

include FHIRHelpers version '4.0.1' called FHIRHelpers
include NCGCommon version '0.1.0' called NCGCommon

codesystem "HistologyCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-histology'
codesystem "StageCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-stage'
codesystem "Stage2ContiguityCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-stage2-contiguity'
codesystem "BoneMarrowCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-bone-marrow'
codesystem "GelfCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-gelf'
codesystem "FitnessCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-fitness'

code "Histology_FlGrade12": 'fl-grade-1-2' from "HistologyCS" display 'FL grade 1-2'
code "Histology_FlGrade3a": 'fl-grade-3a' from "HistologyCS" display 'FL grade 3a'
code "Histology_FlGrade3b": 'fl-grade-3b' from "HistologyCS" display 'FL grade 3b'
code "Histology_FlDuodenal": 'fl-duodenal' from "HistologyCS" display 'Primary duodenal FL'
code "Histology_TransformedDlbcl": 'transformed-dlbcl' from "HistologyCS" display 'Transformed to DLBCL'
code "Stage_Stage1": 'stage-1' from "StageCS" display 'Stage I'
code "Stage_Stage2": 'stage-2' from "StageCS" display 'Stage II'
code "Stage_Stage3": 'stage-3' from "StageCS" display 'Stage III'
code "Stage_Stage4": 'stage-4' from "StageCS" display 'Stage IV'
code "Stage2Contiguity_Contiguous": 'contiguous' from "Stage2ContiguityCS" display 'Contiguous'
code "Stage2Contiguity_NonContiguous": 'non-contiguous' from "Stage2ContiguityCS" display 'Non-contiguous'
code "BoneMarrow_Cleared": 'cleared' from "BoneMarrowCS" display 'Negative (cleared)'
code "BoneMarrow_Involved": 'involved' from "BoneMarrowCS" display 'Involved'
code "Gelf_LowBurden": 'low-burden' from "GelfCS" display 'Low burden'
code "Gelf_HighBurden": 'high-burden' from "GelfCS" display 'High burden'
code "Fitness_Fit": 'fit' from "FitnessCS" display 'Fit'
code "Fitness_Frail": 'frail' from "FitnessCS" display 'Frail / comorbid'

context Patient

/* ---- Findings: one observation per finding, with provenance gate ---- */
define "HistologyObservation":
  singleton from ([Observation: "Histology_FlGrade12"]
    union [Observation: "Histology_FlGrade3a"]
    union [Observation: "Histology_FlGrade3b"]
    union [Observation: "Histology_FlDuodenal"]
    union [Observation: "Histology_TransformedDlbcl"])

define "HistologyKnown":
  "HistologyObservation" is not null and NCGCommon.IsUsable("HistologyObservation")

define "HistologyValue":
  "HistologyObservation".code.coding[0].code

define "StageObservation":
  singleton from ([Observation: "Stage_Stage1"]
    union [Observation: "Stage_Stage2"]
    union [Observation: "Stage_Stage3"]
    union [Observation: "Stage_Stage4"])

define "StageKnown":
  "StageObservation" is not null and NCGCommon.IsUsable("StageObservation")

define "StageValue":
  "StageObservation".code.coding[0].code

define "Stage2ContiguityObservation":
  singleton from ([Observation: "Stage2Contiguity_Contiguous"]
    union [Observation: "Stage2Contiguity_NonContiguous"])

define "Stage2ContiguityKnown":
  "Stage2ContiguityObservation" is not null and NCGCommon.IsUsable("Stage2ContiguityObservation")

define "Stage2ContiguityValue":
  "Stage2ContiguityObservation".code.coding[0].code

define "BoneMarrowObservation":
  singleton from ([Observation: "BoneMarrow_Cleared"]
    union [Observation: "BoneMarrow_Involved"])

define "BoneMarrowKnown":
  "BoneMarrowObservation" is not null and NCGCommon.IsUsable("BoneMarrowObservation")

define "BoneMarrowValue":
  "BoneMarrowObservation".code.coding[0].code

define "GelfObservation":
  singleton from ([Observation: "Gelf_LowBurden"]
    union [Observation: "Gelf_HighBurden"])

define "GelfKnown":
  "GelfObservation" is not null and NCGCommon.IsUsable("GelfObservation")

define "GelfValue":
  "GelfObservation".code.coding[0].code

define "FitnessObservation":
  singleton from ([Observation: "Fitness_Fit"]
    union [Observation: "Fitness_Frail"])

define "FitnessKnown":
  "FitnessObservation" is not null and NCGCommon.IsUsable("FitnessObservation")

define "FitnessValue":
  "FitnessObservation".code.coding[0].code

/* ---- Rules (evaluated in order; first match wins) ---- */
/* Histology unknown */
define "Rule1_HistologyUnknown":
  not "HistologyKnown"

/* Grade 3b or transformed */
define "Rule2_Grade3bOrTransformed":
  ("HistologyKnown" and "HistologyValue" in { 'fl-grade-3b', 'transformed-dlbcl' })

/* Duodenal FL */
define "Rule3_DuodenalFl":
  ("HistologyKnown" and "HistologyValue" in { 'fl-duodenal' })

/* Stage unknown */
define "Rule4_StageUnknown":
  not "StageKnown"

/* Stage I, marrow not assessed */
define "Rule5_StageIMarrowNotAssessed":
  ("StageKnown" and "StageValue" in { 'stage-1' })
    and not "BoneMarrowKnown"

/* Stage I, marrow cleared */
define "Rule6_StageIMarrowCleared":
  ("StageKnown" and "StageValue" in { 'stage-1' })
    and ("BoneMarrowKnown" and "BoneMarrowValue" in { 'cleared' })

/* Stage I but marrow involved (restage as IV) */
define "Rule7_StageIButMarrowInvolvedRestageAsIv":
  ("StageKnown" and "StageValue" in { 'stage-1' })
    and ("BoneMarrowKnown" and "BoneMarrowValue" in { 'involved' })

/* Stage II contiguous */
define "Rule8_StageIiContiguous":
  ("StageKnown" and "StageValue" in { 'stage-2' })
    and ("Stage2ContiguityKnown" and "Stage2ContiguityValue" in { 'contiguous' })

/* Advanced disease, GELF unknown */
define "Rule9_AdvancedDiseaseGelfUnknown":
  ("StageKnown" and "StageValue" in { 'stage-2', 'stage-3', 'stage-4' })
    and not "GelfKnown"

/* Advanced disease, low burden */
define "Rule10_AdvancedDiseaseLowBurden":
  ("StageKnown" and "StageValue" in { 'stage-2', 'stage-3', 'stage-4' })
    and ("GelfKnown" and "GelfValue" in { 'low-burden' })

/* Advanced, high burden, fit */
define "Rule11_AdvancedHighBurdenFit":
  ("StageKnown" and "StageValue" in { 'stage-2', 'stage-3', 'stage-4' })
    and ("GelfKnown" and "GelfValue" in { 'high-burden' })
    and ("FitnessKnown" and "FitnessValue" in { 'fit' })

/* Advanced, high burden, frail */
define "Rule12_AdvancedHighBurdenFrail":
  ("StageKnown" and "StageValue" in { 'stage-2', 'stage-3', 'stage-4' })
    and ("GelfKnown" and "GelfValue" in { 'high-burden' })
    and ("FitnessKnown" and "FitnessValue" in { 'frail' })

/* ---- Treatment group ---- */
define "TreatmentGroup":
  case
    when "Rule1_HistologyUnknown" then 'needs-review'
    when "Rule2_Grade3bOrTransformed" then 'treat-as-dlbcl'
    when "Rule3_DuodenalFl" then 'fl-duodenal-limited'
    when "Rule4_StageUnknown" then 'needs-review'
    when "Rule5_StageIMarrowNotAssessed" then 'needs-review'
    when "Rule6_StageIMarrowCleared" then 'stage-1-limited'
    when "Rule7_StageIButMarrowInvolvedRestageAsIv" then 'needs-review'
    when "Rule8_StageIiContiguous" then 'stage-2-contiguous'
    when "Rule9_AdvancedDiseaseGelfUnknown" then 'needs-review'
    when "Rule10_AdvancedDiseaseLowBurden" then 'advanced-low-burden'
    when "Rule11_AdvancedHighBurdenFit" then 'advanced-high-burden-systemic'
    when "Rule12_AdvancedHighBurdenFrail" then 'advanced-high-burden-frail'
    else 'needs-review'
  end

/* ---- Recommended regimens ---- */
define "RecommendedRegimens":
  case "TreatmentGroup"
    when 'treat-as-dlbcl' then { 'R-CHOP x 6 cycles (+/- ISRT to bulky sites)', 'Polatuzumab vedotin + R-CHP' }
    when 'fl-duodenal-limited' then { 'Observation / watchful waiting', 'ISRT 24-30 Gy if symptomatic' }
    when 'stage-1-limited' then { 'ISRT 24 Gy in 12 fractions', 'Watchful waiting if radiotherapy contraindicated' }
    when 'stage-2-contiguous' then { 'IFRT / ISRT 24 Gy', 'Single-agent rituximab 375 mg/m2 weekly x 4' }
    when 'advanced-low-burden' then { 'Watchful waiting (review every 3-6 months)', 'Single-agent rituximab x 4 if patient declines observation' }
    when 'advanced-high-burden-systemic' then { 'Bendamustine + rituximab (BR) x 6', 'R-CHOP x 6', 'Rituximab + lenalidomide (R2)' }
    when 'advanced-high-burden-frail' then { 'Single-agent rituximab weekly x 4', 'Attenuated bendamustine + rituximab', 'R-CVP' }
    else { }
  end
