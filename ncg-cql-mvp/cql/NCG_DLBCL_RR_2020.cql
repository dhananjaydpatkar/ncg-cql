library NCG_DLBCL_RR_2020 version '1.0.0'

/*
 * Relapsed / Refractory DLBCL - Salvage, CAR-T & Palliative Pathways
 * Source: NCG Guidelines - Relapsed / Refractory DLBCL Treatment Workflow Flowchart
 * Organization: National Cancer Grid (India) / NCG-Heme Working Group
 * Status: DRAFT
 * Generated by NCG Guideline Studio. Do not edit by hand - edit the guideline instead.
 */

using FHIR version '4.0.1'

include FHIRHelpers version '4.0.1' called FHIRHelpers
include NCGCommon version '0.1.0' called NCGCommon

codesystem "RelapseBiopsyStatusCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-relapse-biopsy-status'
codesystem "RelapseTimingCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-relapse-timing'
codesystem "ChemoFitnessOverallCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-chemo-fitness-overall'
codesystem "AsctFitnessCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-asct-fitness'
codesystem "CarTFitnessCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-car-t-fitness'
codesystem "PetResponseSalvageCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-pet-response-salvage'
codesystem "CarTFuturePlanCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-car-t-future-plan'
codesystem "CellOfOriginRrCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-cell-of-origin-rr'
codesystem "DominantResidualSiteCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-dominant-residual-site'

code "RelapseBiopsyStatus_BiopsyConfirmedDlbcl": 'biopsy-confirmed-dlbcl' from "RelapseBiopsyStatusCS" display 'Biopsy confirmed DLBCL (repeat IHC completed)'
code "RelapseBiopsyStatus_TransformationIndolent": 'transformation-indolent' from "RelapseBiopsyStatusCS" display 'Transformed from prior indolent lymphoma (e.g. transformed FL)'
code "RelapseBiopsyStatus_BiopsyPending": 'biopsy-pending' from "RelapseBiopsyStatusCS" display 'Biopsy pending / FNAC only (repeat core/excisional biopsy mandatory)'
code "RelapseTiming_RelapseGt12m": 'relapse-gt-12m' from "RelapseTimingCS" display 'Late relapse (> 12 months post completion of first-line R-CHOP)'
code "RelapseTiming_RelapseLe12m": 'relapse-le-12m' from "RelapseTimingCS" display 'Early relapse (<= 12 months post completion of first-line R-CHOP)'
code "RelapseTiming_PrimaryRefractory": 'primary-refractory' from "RelapseTimingCS" display 'Primary refractory / progression ON first-line R-CHOP therapy'
code "ChemoFitnessOverall_ChemoEligible": 'chemo-eligible' from "ChemoFitnessOverallCS" display 'Chemotherapy eligible (candidate for intensive or standard combination salvage)'
code "ChemoFitnessOverall_UnfitAllChemo": 'unfit-all-chemo' from "ChemoFitnessOverallCS" display 'Unfit for combination chemotherapy (candidate for palliative / oral metronomic / targeted only)'
code "AsctFitness_AsctFit": 'asct-fit' from "AsctFitnessCS" display 'Fit for intensive salvage therapy + Autologous Stem Cell Transplant (ASCT)'
code "AsctFitness_AsctUnfit": 'asct-unfit' from "AsctFitnessCS" display 'Not fit for ASCT (non-transplant candidate)'
code "CarTFitness_CarTFit": 'car-t-fit' from "CarTFitnessCS" display 'Fit for CAR-T cell therapy (tolerable CRS/ICANS risk, adequate organ reserve)'
code "CarTFitness_CarTUnfit": 'car-t-unfit' from "CarTFitnessCS" display 'Not fit for CAR-T cell therapy'
code "PetResponseSalvage_SalvageCrPr": 'salvage-cr-pr' from "PetResponseSalvageCS" display 'Chemosensitive: PR or CR (Deauville Score 1-3, >= 50% reduction in uptake)'
code "PetResponseSalvage_SalvageDs4Partial": 'salvage-ds4-partial' from "PetResponseSalvageCS" display 'Partial response / residual uptake (Deauville Score 4, no new disease sites)'
code "PetResponseSalvage_SalvageDs5Refractory": 'salvage-ds5-refractory' from "PetResponseSalvageCS" display 'Chemotherapy-refractory (Deauville Score 5 or progressive disease)'
code "PetResponseSalvage_NotAssessed": 'not-assessed' from "PetResponseSalvageCS" display 'Not yet assessed / salvage therapy not yet completed'
code "CarTFuturePlan_CartPossible": 'cart-possible' from "CarTFuturePlanCS" display 'CAR-T is planned or remains a future possibility (MANDATORY TO AVOID BENDA / POLA-BR)'
code "CarTFuturePlan_CartDefinitivelyExcluded": 'cart-definitively-excluded' from "CarTFuturePlanCS" display 'CAR-T is definitively NOT planned / patient ineligible / unavailable'
code "CellOfOriginRr_NonGcb": 'non-gcb' from "CellOfOriginRrCS" display 'Non-GCB phenotype (eligible for targeted lenalidomide / bortezomib)'
code "CellOfOriginRr_Gcb": 'gcb' from "CellOfOriginRrCS" display 'GCB phenotype'
code "DominantResidualSite_SingleSiteResidual": 'single-site-residual' from "DominantResidualSiteCS" display 'Single residual PET+ site OR initial bulky site (candidate for consolidative RT 30-36 Gy)'
code "DominantResidualSite_DiffuseMultisite": 'diffuse-multisite' from "DominantResidualSiteCS" display 'Diffuse widespread multi-site disease (systemic therapy only)'
code "DominantResidualSite_NoResidualCmr": 'no-residual-cmr' from "DominantResidualSiteCS" display 'Complete metabolic response (no residual uptake)'

context Patient

/* ---- Findings: one observation per finding, with provenance gate ---- */
define "RelapseBiopsyStatusObservation":
  singleton from ([Observation: "RelapseBiopsyStatus_BiopsyConfirmedDlbcl"]
    union [Observation: "RelapseBiopsyStatus_TransformationIndolent"]
    union [Observation: "RelapseBiopsyStatus_BiopsyPending"])

define "RelapseBiopsyStatusKnown":
  "RelapseBiopsyStatusObservation" is not null and NCGCommon.IsUsable("RelapseBiopsyStatusObservation")

define "RelapseBiopsyStatusValue":
  "RelapseBiopsyStatusObservation".code.coding[0].code

define "RelapseTimingObservation":
  singleton from ([Observation: "RelapseTiming_RelapseGt12m"]
    union [Observation: "RelapseTiming_RelapseLe12m"]
    union [Observation: "RelapseTiming_PrimaryRefractory"])

define "RelapseTimingKnown":
  "RelapseTimingObservation" is not null and NCGCommon.IsUsable("RelapseTimingObservation")

define "RelapseTimingValue":
  "RelapseTimingObservation".code.coding[0].code

define "ChemoFitnessOverallObservation":
  singleton from ([Observation: "ChemoFitnessOverall_ChemoEligible"]
    union [Observation: "ChemoFitnessOverall_UnfitAllChemo"])

define "ChemoFitnessOverallKnown":
  "ChemoFitnessOverallObservation" is not null and NCGCommon.IsUsable("ChemoFitnessOverallObservation")

define "ChemoFitnessOverallValue":
  "ChemoFitnessOverallObservation".code.coding[0].code

define "AsctFitnessObservation":
  singleton from ([Observation: "AsctFitness_AsctFit"]
    union [Observation: "AsctFitness_AsctUnfit"])

define "AsctFitnessKnown":
  "AsctFitnessObservation" is not null and NCGCommon.IsUsable("AsctFitnessObservation")

define "AsctFitnessValue":
  "AsctFitnessObservation".code.coding[0].code

define "CarTFitnessObservation":
  singleton from ([Observation: "CarTFitness_CarTFit"]
    union [Observation: "CarTFitness_CarTUnfit"])

define "CarTFitnessKnown":
  "CarTFitnessObservation" is not null and NCGCommon.IsUsable("CarTFitnessObservation")

define "CarTFitnessValue":
  "CarTFitnessObservation".code.coding[0].code

define "PetResponseSalvageObservation":
  singleton from ([Observation: "PetResponseSalvage_SalvageCrPr"]
    union [Observation: "PetResponseSalvage_SalvageDs4Partial"]
    union [Observation: "PetResponseSalvage_SalvageDs5Refractory"]
    union [Observation: "PetResponseSalvage_NotAssessed"])

define "PetResponseSalvageKnown":
  "PetResponseSalvageObservation" is not null and NCGCommon.IsUsable("PetResponseSalvageObservation")

define "PetResponseSalvageValue":
  "PetResponseSalvageObservation".code.coding[0].code

define "CarTFuturePlanObservation":
  singleton from ([Observation: "CarTFuturePlan_CartPossible"]
    union [Observation: "CarTFuturePlan_CartDefinitivelyExcluded"])

define "CarTFuturePlanKnown":
  "CarTFuturePlanObservation" is not null and NCGCommon.IsUsable("CarTFuturePlanObservation")

define "CarTFuturePlanValue":
  "CarTFuturePlanObservation".code.coding[0].code

define "CellOfOriginRrObservation":
  singleton from ([Observation: "CellOfOriginRr_NonGcb"]
    union [Observation: "CellOfOriginRr_Gcb"])

define "CellOfOriginRrKnown":
  "CellOfOriginRrObservation" is not null and NCGCommon.IsUsable("CellOfOriginRrObservation")

define "CellOfOriginRrValue":
  "CellOfOriginRrObservation".code.coding[0].code

define "DominantResidualSiteObservation":
  singleton from ([Observation: "DominantResidualSite_SingleSiteResidual"]
    union [Observation: "DominantResidualSite_DiffuseMultisite"]
    union [Observation: "DominantResidualSite_NoResidualCmr"])

define "DominantResidualSiteKnown":
  "DominantResidualSiteObservation" is not null and NCGCommon.IsUsable("DominantResidualSiteObservation")

define "DominantResidualSiteValue":
  "DominantResidualSiteObservation".code.coding[0].code

/* ---- Rules (evaluated in order; first match wins) ---- */
/* Biopsy pending: Mandatory repeat biopsy before salvage */
define "Rule1_BiopsyPendingMandatoryRepeatBiopsyBefore":
  ("RelapseBiopsyStatusKnown" and "RelapseBiopsyStatusValue" in { 'biopsy-pending' })

/* Relapse timing or overall fitness unknown */
define "Rule2_RelapseTimingOrOverallFitnessUnknown":
  not "RelapseTimingKnown"

/* Overall chemotherapy fitness unknown */
define "Rule3_OverallChemotherapyFitnessUnknown":
  not "ChemoFitnessOverallKnown"

/* Unfit for chemo, Non-GCB: Targeted Lenalidomide / Bortezomib */
define "Rule4_UnfitForChemoNonGcbTargetedLenalidomideB":
  ("ChemoFitnessOverallKnown" and "ChemoFitnessOverallValue" in { 'unfit-all-chemo' })
    and ("CellOfOriginRrKnown" and "CellOfOriginRrValue" in { 'non-gcb' })

/* Unfit for chemo: Palliative care + Oral metronomic chemotherapy */
define "Rule5_UnfitForChemoPalliativeCareOralMetronomi":
  ("ChemoFitnessOverallKnown" and "ChemoFitnessOverallValue" in { 'unfit-all-chemo' })

/* Early relapse / refractory, Fit for CAR-T: Primary CAR-T Therapy */
define "Rule6_EarlyRelapseRefractoryFitForCarTPrimaryC":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-le-12m', 'primary-refractory' })
    and ("CarTFitnessKnown" and "CarTFitnessValue" in { 'car-t-fit' })

/* Early relapse / refractory, NOT Fit for CAR-T (CAR-T definitively excluded): Pola-BR */
define "Rule7_EarlyRelapseRefractoryNotFitForCarTCarTD":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-le-12m', 'primary-refractory' })
    and ("CarTFitnessKnown" and "CarTFitnessValue" in { 'car-t-unfit' })
    and ("CarTFuturePlanKnown" and "CarTFuturePlanValue" in { 'cart-definitively-excluded' })

/* Early relapse / refractory, NOT Fit for CAR-T: Glofitamab-GEMOX */
define "Rule8_EarlyRelapseRefractoryNotFitForCarTGlofi":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-le-12m', 'primary-refractory' })
    and ("CarTFitnessKnown" and "CarTFitnessValue" in { 'car-t-unfit' })

/* Late relapse, post-salvage chemosensitive (PR or better, DS 1-3): ASCT */
define "Rule9_LateRelapsePostSalvageChemosensitivePrOr":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-gt-12m' })
    and ("AsctFitnessKnown" and "AsctFitnessValue" in { 'asct-fit' })
    and ("PetResponseSalvageKnown" and "PetResponseSalvageValue" in { 'salvage-cr-pr' })

/* Late relapse, post-salvage DS-4 partial uptake: Biopsy & CAR-T triage */
define "Rule10_LateRelapsePostSalvageDs4PartialUptakeBi":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-gt-12m' })
    and ("AsctFitnessKnown" and "AsctFitnessValue" in { 'asct-fit' })
    and ("PetResponseSalvageKnown" and "PetResponseSalvageValue" in { 'salvage-ds4-partial' })

/* Late relapse, salvage refractory (DS-5): Re-assess for CAR-T */
define "Rule11_LateRelapseSalvageRefractoryDs5ReAssessF":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-gt-12m' })
    and ("PetResponseSalvageKnown" and "PetResponseSalvageValue" in { 'salvage-ds5-refractory' })

/* Late relapse, Fit for ASCT: Salvage Chemotherapy x 3 Cycles */
define "Rule12_LateRelapseFitForAsctSalvageChemotherapy":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-gt-12m' })
    and ("AsctFitnessKnown" and "AsctFitnessValue" in { 'asct-fit' })

/* Single residual site post-salvage: Consolidative Radiotherapy (30-36 Gy) */
define "Rule13_SingleResidualSitePostSalvageConsolidati":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-gt-12m' })
    and ("AsctFitnessKnown" and "AsctFitnessValue" in { 'asct-unfit' })
    and ("DominantResidualSiteKnown" and "DominantResidualSiteValue" in { 'single-site-residual' })
    and ("PetResponseSalvageKnown" and "PetResponseSalvageValue" in { 'salvage-ds4-partial' })

/* Late relapse, NOT Fit for ASCT: Non-Transplant Salvage x 6 Cycles */
define "Rule14_LateRelapseNotFitForAsctNonTransplantSal":
  ("RelapseTimingKnown" and "RelapseTimingValue" in { 'relapse-gt-12m' })
    and ("AsctFitnessKnown" and "AsctFitnessValue" in { 'asct-unfit' })

/* ---- Treatment group ---- */
define "TreatmentGroup":
  case
    when "Rule1_BiopsyPendingMandatoryRepeatBiopsyBefore" then 'rr-biopsy-mandatory-gate'
    when "Rule2_RelapseTimingOrOverallFitnessUnknown" then 'needs-review'
    when "Rule3_OverallChemotherapyFitnessUnknown" then 'needs-review'
    when "Rule4_UnfitForChemoNonGcbTargetedLenalidomideB" then 'rr-pathway-c-palliative-nongcb'
    when "Rule5_UnfitForChemoPalliativeCareOralMetronomi" then 'rr-pathway-c-palliative-supportive'
    when "Rule6_EarlyRelapseRefractoryFitForCarTPrimaryC" then 'rr-pathway-b-cart-primary'
    when "Rule7_EarlyRelapseRefractoryNotFitForCarTCarTD" then 'rr-pathway-b-cart-unfit-pola-br'
    when "Rule8_EarlyRelapseRefractoryNotFitForCarTGlofi" then 'rr-pathway-b-cart-unfit-glofit'
    when "Rule9_LateRelapsePostSalvageChemosensitivePrOr" then 'rr-pathway-a-asct-consolidation'
    when "Rule10_LateRelapsePostSalvageDs4PartialUptakeBi" then 'rr-pathway-a-ds4-biopsy-triage'
    when "Rule11_LateRelapseSalvageRefractoryDs5ReAssessF" then 'rr-pathway-a-ds5-salvage-cart'
    when "Rule12_LateRelapseFitForAsctSalvageChemotherapy" then 'rr-pathway-a-salvage-fit'
    when "Rule13_SingleResidualSitePostSalvageConsolidati" then 'rr-consolidative-radiotherapy'
    when "Rule14_LateRelapseNotFitForAsctNonTransplantSal" then 'rr-pathway-a-nontransplant-salvage'
    else 'needs-review'
  end

/* ---- Recommended regimens ---- */
define "RecommendedRegimens":
  case "TreatmentGroup"
    when 'rr-biopsy-mandatory-gate' then { 'Whole-body 18F-FDG PET-CT to identify highest SUVmax biopsy site', 'Image-guided core needle or surgical excisional biopsy of dominant lesion', 'Repeat immunohistochemistry panel (CD20, CD10, BCL6, MUM1, MYC, BCL2)', 'Baseline 2D-ECHO (LVEF) & Viral screening (HBsAg, HBcAb, HCV, HIV)' }
    when 'rr-pathway-a-salvage-fit' then { 'R-GEMOX x 3 cycles (Rituximab 375 mg/m2 D1, Gemcitabine 1000 mg/m2 D1,8, Oxaliplatin 100 mg/m2 D1 q14d)', 'Alternative: R-GDP x 3 cycles (Rituximab, Gemcitabine, Dexamethasone, Cisplatin/Carboplatin)', 'Alternative: Pola-R-GEMOX x 3 cycles (Polatuzumab vedotin + R-GEMOX)', 'Mandatory 18F-FDG PET-CT response evaluation after cycle 3' }
    when 'rr-pathway-a-asct-consolidation' then { 'Peripheral blood stem cell (PBSC) mobilization (G-CSF +/- Plerixafor) and apheresis harvest', 'High-dose conditioning chemotherapy (BEAM regimen: Carmustine, Etoposide, Cytarabine, Melphalan)', 'Autologous stem cell transplantation and post-transplant supportive care', 'Consolidative ISRT 30-36 Gy to single residual or initial presentation bulky site post-ASCT' }
    when 'rr-pathway-a-ds4-biopsy-triage' then { 'Targeted biopsy of residual FDG-avid mass to verify viable lymphoma vs inflammatory necrosis', 'Multidisciplinary Tumor Board review for CAR-T eligibility vs consolidative RT' }
    when 'rr-pathway-a-ds5-salvage-cart' then { 'Urgent referral to CAR-T certified cellular therapy center', 'Anti-CD19 CAR-T cell infusion (Axi-cel, Tisa-cel, or Liso-cel)', 'Non-bendamustine bridging therapy (R-GEMOX or localized RT)' }
    when 'rr-pathway-a-nontransplant-salvage' then { 'R-GEMOX / R-GDP / Pola-R-GEMOX x 3 cycles -> if responding complete 6 cycles total', 'Alternative: Glofitamab-GEM-OX (CD20xCD3 bispecific + GemOx)', 'Note: Carboplatin replaces cisplatin in R-GDP for renal impairment', 'Consolidative RT (30-36 Gy) to single residual or bulky presentation site post-chemotherapy' }
    when 'rr-pathway-b-cart-primary' then { 'T-cell leukapheresis for anti-CD19 CAR-T manufacturing (Axi-cel / Tisa-cel / Liso-cel)', 'Bridging therapy: R-GEMOX or Pola-R-GEMOX or dominant-site RT (STRICTLY AVOID BENDAMUSTINE)', 'Pre-infusion lymphodepleting chemotherapy: Fludarabine (30 mg/m2 D1-3) + Cyclophosphamide (300 mg/m2 D1-3)', 'Anti-CD19 CAR-T cell infusion with mandatory inpatient CRS and ICANS neurotoxicity monitoring' }
    when 'rr-pathway-b-cart-unfit-glofit' then { 'Obinutuzumab pre-treatment (1000 mg IV on D-7 of Cycle 1) to deplete circulating B cells and mitigate CRS', 'Glofitamab step-up dosing (2.5 mg D8, 10 mg D15 of Cycle 1, then 30 mg D1 Cycle 2 onwards)', 'Gemcitabine (1000 mg/m2) + Oxaliplatin (100 mg/m2) chemotherapy backbone', 'Alternative if Glofitamab unavailable: R-GEMOX / R-GDP x 6 cycles' }
    when 'rr-pathway-b-cart-unfit-pola-br' then { 'Polatuzumab vedotin (1.8 mg/kg D1) + Bendamustine (90 mg/m2 D1,2) + Rituximab (375 mg/m2 D1) x 6 cycles q28d', 'Prophylactic G-CSF support in every cycle', 'End-of-treatment PET-CT assessment' }
    when 'rr-pathway-c-palliative-nongcb' then { 'Oral Lenalidomide (20-25 mg daily D1-21 q28d +/- Rituximab)', 'Alternative: Subcutaneous Bortezomib-based therapy', 'Palliative symptom care, pain management, and transfusion support', 'Palliative radiotherapy to localized painful or symptomatic sites' }
    when 'rr-pathway-c-palliative-supportive' then { 'Best supportive care: pain control, nutritional support, palliative care team co-management', 'Oral metronomic chemotherapy (e.g. low-dose oral etoposide 50 mg/m2 or oral cyclophosphamide)', 'Palliative RT for localized bleeding, bone pain, or mass obstruction' }
    when 'rr-consolidative-radiotherapy' then { 'Consolidative ISRT 30-36 Gy delivered to single residual FDG-avid lesion or initial presentation bulk', 'Post-radiotherapy PET-CT assessment at 12 weeks' }
    else { }
  end

/* ---- Advanced custom CQL definitions ---- */
/* Strict T-cell harvesting contraindication: Pola-BR and Bendamustine must NOT be administered if CAR-T remains a future option */
define function Avoid_Bendamustine_Safety_Rule(cartFuturePlan String, proposedRegimen String) returns Boolean:
  cartFuturePlan in { 'cart-possible' } and proposedRegimen in { 'Pola-BR', 'Bendamustine' }

/* Radiation Consolidation Gate: 30-36 Gy indicated for single residual FDG-avid site after salvage or presentation bulk post-ASCT */
define function Qualifies_For_Consolidative_RT(residualSiteStatus String, postChemoResponse String) returns Boolean:
  residualSiteStatus in { 'single-site-residual' } and postChemoResponse in { 'salvage-cr-pr', 'salvage-ds4-partial' }

/* Mandatory tissue biopsy verification gate prior to any salvage therapy initiation */
define function Mandatory_Repeat_Biopsy_Required(biopsyStatus String) returns Boolean:
  biopsyStatus in { 'biopsy-pending' }
