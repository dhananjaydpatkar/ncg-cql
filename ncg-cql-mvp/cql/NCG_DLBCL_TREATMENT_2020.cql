library NCG_DLBCL_TREATMENT_2020 version '1.0.0'

/*
 * DLBCL & PMBCL - First-Line Treatment Pathway
 * Source: NCG Guidelines - Lymphoma Treatment Workflow (DLBCL & PMBCL)
 * Organization: National Cancer Grid (India) / NCG-Heme Working Group
 * Status: DRAFT
 * Generated by NCG Guideline Studio. Do not edit by hand - edit the guideline instead.
 */

using FHIR version '4.0.1'

include FHIRHelpers version '4.0.1' called FHIRHelpers
include NCGCommon version '0.1.0' called NCGCommon

codesystem "LymphomaSubtypeCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-lymphoma-subtype'
codesystem "AnthracyclineFitnessCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-anthracycline-fitness'
codesystem "DlbclStageCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-dlbcl-stage'
codesystem "BulkyStatusCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-bulky-status'
codesystem "CellOfOriginCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-cell-of-origin'
codesystem "CnsRiskSitesCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-cns-risk-sites'
codesystem "ViralScreeningHivCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-viral-screening-hiv'
codesystem "Cd4CountCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-cd4-count'
codesystem "CentralVenousAccessCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-central-venous-access'
codesystem "CardiacEchoStatusCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-cardiac-echo-status'
codesystem "PrephaseIndicationCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-prephase-indication'
codesystem "AgeGroupCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-age-group'
codesystem "SerumLdhCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-serum-ldh'
codesystem "EcogPsCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-ecog-ps'
codesystem "ExtranodalSitesCS": 'http://ncgindia.org/fhir/CodeSystem/ncg-extranodal-sites'

code "LymphomaSubtype_Dlbcl": 'dlbcl' from "LymphomaSubtypeCS" display 'Diffuse Large B-Cell Lymphoma (DLBCL)'
code "LymphomaSubtype_Pmbcl": 'pmbcl' from "LymphomaSubtypeCS" display 'Primary Mediastinal B-Cell Lymphoma (PMBCL)'
code "AnthracyclineFitness_FitRChop": 'fit-r-chop' from "AnthracyclineFitnessCS" display 'Fit for standard R-CHOP (LVEF >= 50%, Age < 70, controlled comorbidities)'
code "AnthracyclineFitness_UnfitCardiac": 'unfit-cardiac' from "AnthracyclineFitnessCS" display 'Cardiac dysfunction / CAD / RWMA / prior anthracycline toxicity (LVEF < 50%)'
code "AnthracyclineFitness_UnfitElderlyFrail": 'unfit-elderly-frail' from "AnthracyclineFitnessCS" display 'Elderly with significant frailty / comorbid (Age > 70 with frailty)'
code "AnthracyclineFitness_UnfitAnthraIneligible": 'unfit-anthra-ineligible' from "AnthracyclineFitnessCS" display 'Severe hepatic / renal / systemic contraindication to anthracyclines'
code "AnthracyclineFitness_FrailPalliative": 'frail-palliative' from "AnthracyclineFitnessCS" display 'Frail / advanced decline (candidate for palliative / low-intensity therapy only)'
code "DlbclStage_Stage12Limited": 'stage-1-2-limited' from "DlbclStageCS" display 'Limited Stage (Stage I & II)'
code "DlbclStage_Stage34Advanced": 'stage-3-4-advanced' from "DlbclStageCS" display 'Advanced Stage (Stage III & IV)'
code "BulkyStatus_NonBulky": 'non-bulky' from "BulkyStatusCS" display 'Non-bulky disease (largest lesion < 7.5 cm)'
code "BulkyStatus_BulkyGte75cm": 'bulky-gte-7-5cm' from "BulkyStatusCS" display 'Bulky disease (largest lesion >= 7.5 cm)'
code "CellOfOrigin_Gcb": 'gcb' from "CellOfOriginCS" display 'GCB (Germinal Center B-cell phenotype)'
code "CellOfOrigin_NonGcb": 'non-gcb' from "CellOfOriginCS" display 'Non-GCB / ABC (Activated B-cell phenotype)'
code "CnsRiskSites_CnsHighRisk": 'cns-high-risk' from "CnsRiskSitesCS" display 'High CNS risk (testicular, breast, adnexal, renal, adrenal DLBCL or DHL)'
code "CnsRiskSites_CnsStandardRisk": 'cns-standard-risk' from "CnsRiskSitesCS" display 'Standard CNS risk (no high-risk anatomical involvement)'
code "ViralScreeningHiv_HivNegative": 'hiv-negative' from "ViralScreeningHivCS" display 'HIV serology negative / non-reactive'
code "ViralScreeningHiv_HivPositive": 'hiv-positive' from "ViralScreeningHivCS" display 'HIV confirmed positive (requires CD4 count & ART coordination)'
code "Cd4Count_Cd4Gte50": 'cd4-gte-50' from "Cd4CountCS" display 'CD4 >= 50 cells/uL (Rituximab permitted)'
code "Cd4Count_Cd4Lt50": 'cd4-lt-50' from "Cd4CountCS" display 'CD4 < 50 cells/uL (Rituximab contraindicated / avoided)'
code "Cd4Count_NotApplicable": 'not-applicable' from "Cd4CountCS" display 'Not applicable (HIV negative)'
code "CentralVenousAccess_CentralAccessAvailable": 'central-access-available' from "CentralVenousAccessCS" display 'Central venous access available (PICC line or chemo port in place)'
code "CentralVenousAccess_NoCentralAccess": 'no-central-access' from "CentralVenousAccessCS" display 'No central venous access / peripheral IV only'
code "CardiacEchoStatus_EchoNormalStable": 'echo-normal-stable' from "CardiacEchoStatusCS" display 'LVEF >= 50% and stable (decline <= 10% from baseline)'
code "CardiacEchoStatus_EchoLvefDeclined": 'echo-lvef-declined' from "CardiacEchoStatusCS" display 'LVEF decline > 10% from baseline (cardiotoxicity gate)'
code "PrephaseIndication_PrephaseIndicated": 'prephase-indicated' from "PrephaseIndicationCS" display 'Pre-phase indicated (elderly III/IV, bulky, GI involvement, poor PS)'
code "PrephaseIndication_PrephaseNotIndicated": 'prephase-not-indicated' from "PrephaseIndicationCS" display 'No pre-phase indicated (standard good PS non-bulky)'
code "AgeGroup_AgeLe60": 'age-le-60' from "AgeGroupCS" display 'Age <= 60 years'
code "AgeGroup_AgeGt60": 'age-gt-60' from "AgeGroupCS" display 'Age > 60 years'
code "SerumLdh_LdhNormal": 'ldh-normal' from "SerumLdhCS" display 'Normal (<= ULN)'
code "SerumLdh_LdhElevated": 'ldh-elevated' from "SerumLdhCS" display 'Elevated (> ULN)'
code "EcogPs_Ecog01": 'ecog-0-1' from "EcogPsCS" display 'ECOG 0-1 (ambulatory, fully active or restricted light work)'
code "EcogPs_Ecog24": 'ecog-2-4' from "EcogPsCS" display 'ECOG >= 2 (capable of limited self-care, bed/chair > 50% waking hours)'
code "ExtranodalSites_Extranodal01": 'extranodal-0-1' from "ExtranodalSitesCS" display '0 or 1 extranodal site'
code "ExtranodalSites_ExtranodalGt1": 'extranodal-gt-1' from "ExtranodalSitesCS" display '> 1 extranodal site'

context Patient

/* ---- Findings: one observation per finding, with provenance gate ---- */
define "LymphomaSubtypeObservation":
  singleton from ([Observation: "LymphomaSubtype_Dlbcl"]
    union [Observation: "LymphomaSubtype_Pmbcl"])

define "LymphomaSubtypeKnown":
  "LymphomaSubtypeObservation" is not null and NCGCommon.IsUsable("LymphomaSubtypeObservation")

define "LymphomaSubtypeValue":
  "LymphomaSubtypeObservation".code.coding[0].code

define "AnthracyclineFitnessObservation":
  singleton from ([Observation: "AnthracyclineFitness_FitRChop"]
    union [Observation: "AnthracyclineFitness_UnfitCardiac"]
    union [Observation: "AnthracyclineFitness_UnfitElderlyFrail"]
    union [Observation: "AnthracyclineFitness_UnfitAnthraIneligible"]
    union [Observation: "AnthracyclineFitness_FrailPalliative"])

define "AnthracyclineFitnessKnown":
  "AnthracyclineFitnessObservation" is not null and NCGCommon.IsUsable("AnthracyclineFitnessObservation")

define "AnthracyclineFitnessValue":
  "AnthracyclineFitnessObservation".code.coding[0].code

define "DlbclStageObservation":
  singleton from ([Observation: "DlbclStage_Stage12Limited"]
    union [Observation: "DlbclStage_Stage34Advanced"])

define "DlbclStageKnown":
  "DlbclStageObservation" is not null and NCGCommon.IsUsable("DlbclStageObservation")

define "DlbclStageValue":
  "DlbclStageObservation".code.coding[0].code

define "BulkyStatusObservation":
  singleton from ([Observation: "BulkyStatus_NonBulky"]
    union [Observation: "BulkyStatus_BulkyGte75cm"])

define "BulkyStatusKnown":
  "BulkyStatusObservation" is not null and NCGCommon.IsUsable("BulkyStatusObservation")

define "BulkyStatusValue":
  "BulkyStatusObservation".code.coding[0].code

define "CellOfOriginObservation":
  singleton from ([Observation: "CellOfOrigin_Gcb"]
    union [Observation: "CellOfOrigin_NonGcb"])

define "CellOfOriginKnown":
  "CellOfOriginObservation" is not null and NCGCommon.IsUsable("CellOfOriginObservation")

define "CellOfOriginValue":
  "CellOfOriginObservation".code.coding[0].code

define "CnsRiskSitesObservation":
  singleton from ([Observation: "CnsRiskSites_CnsHighRisk"]
    union [Observation: "CnsRiskSites_CnsStandardRisk"])

define "CnsRiskSitesKnown":
  "CnsRiskSitesObservation" is not null and NCGCommon.IsUsable("CnsRiskSitesObservation")

define "CnsRiskSitesValue":
  "CnsRiskSitesObservation".code.coding[0].code

define "ViralScreeningHivObservation":
  singleton from ([Observation: "ViralScreeningHiv_HivNegative"]
    union [Observation: "ViralScreeningHiv_HivPositive"])

define "ViralScreeningHivKnown":
  "ViralScreeningHivObservation" is not null and NCGCommon.IsUsable("ViralScreeningHivObservation")

define "ViralScreeningHivValue":
  "ViralScreeningHivObservation".code.coding[0].code

define "Cd4CountObservation":
  singleton from ([Observation: "Cd4Count_Cd4Gte50"]
    union [Observation: "Cd4Count_Cd4Lt50"]
    union [Observation: "Cd4Count_NotApplicable"])

define "Cd4CountKnown":
  "Cd4CountObservation" is not null and NCGCommon.IsUsable("Cd4CountObservation")

define "Cd4CountValue":
  "Cd4CountObservation".code.coding[0].code

define "CentralVenousAccessObservation":
  singleton from ([Observation: "CentralVenousAccess_CentralAccessAvailable"]
    union [Observation: "CentralVenousAccess_NoCentralAccess"])

define "CentralVenousAccessKnown":
  "CentralVenousAccessObservation" is not null and NCGCommon.IsUsable("CentralVenousAccessObservation")

define "CentralVenousAccessValue":
  "CentralVenousAccessObservation".code.coding[0].code

define "CardiacEchoStatusObservation":
  singleton from ([Observation: "CardiacEchoStatus_EchoNormalStable"]
    union [Observation: "CardiacEchoStatus_EchoLvefDeclined"])

define "CardiacEchoStatusKnown":
  "CardiacEchoStatusObservation" is not null and NCGCommon.IsUsable("CardiacEchoStatusObservation")

define "CardiacEchoStatusValue":
  "CardiacEchoStatusObservation".code.coding[0].code

define "PrephaseIndicationObservation":
  singleton from ([Observation: "PrephaseIndication_PrephaseIndicated"]
    union [Observation: "PrephaseIndication_PrephaseNotIndicated"])

define "PrephaseIndicationKnown":
  "PrephaseIndicationObservation" is not null and NCGCommon.IsUsable("PrephaseIndicationObservation")

define "PrephaseIndicationValue":
  "PrephaseIndicationObservation".code.coding[0].code

define "AgeGroupObservation":
  singleton from ([Observation: "AgeGroup_AgeLe60"]
    union [Observation: "AgeGroup_AgeGt60"])

define "AgeGroupKnown":
  "AgeGroupObservation" is not null and NCGCommon.IsUsable("AgeGroupObservation")

define "AgeGroupValue":
  "AgeGroupObservation".code.coding[0].code

define "SerumLdhObservation":
  singleton from ([Observation: "SerumLdh_LdhNormal"]
    union [Observation: "SerumLdh_LdhElevated"])

define "SerumLdhKnown":
  "SerumLdhObservation" is not null and NCGCommon.IsUsable("SerumLdhObservation")

define "SerumLdhValue":
  "SerumLdhObservation".code.coding[0].code

define "EcogPsObservation":
  singleton from ([Observation: "EcogPs_Ecog01"]
    union [Observation: "EcogPs_Ecog24"])

define "EcogPsKnown":
  "EcogPsObservation" is not null and NCGCommon.IsUsable("EcogPsObservation")

define "EcogPsValue":
  "EcogPsObservation".code.coding[0].code

define "ExtranodalSitesObservation":
  singleton from ([Observation: "ExtranodalSites_Extranodal01"]
    union [Observation: "ExtranodalSites_ExtranodalGt1"])

define "ExtranodalSitesKnown":
  "ExtranodalSitesObservation" is not null and NCGCommon.IsUsable("ExtranodalSitesObservation")

define "ExtranodalSitesValue":
  "ExtranodalSitesObservation".code.coding[0].code

/* ---- Score functions (authored in the Functions tab; usable in rules) ---- */
/* Age-adjusted IPI (aaIPI) - Age-adjusted International Prognostic Index for DLBCL in patients age <= 60 years. Sums Stage III-IV (1 pt), elevated LDH (1 pt), and ECOG >= 2 (1 pt). Max: 3. */
define function Calculate_aaIPI(dlbclStage String, serumLdh String, ecogPs String) returns Integer:
  (case dlbclStage when 'stage-3-4-advanced' then 1 else 0 end)
    + (case serumLdh when 'ldh-elevated' then 1 else 0 end)
    + (case ecogPs when 'ecog-2-4' then 1 else 0 end)

define function Classify_aaIPI(score Integer) returns String:
  case
    when score between 0 and 0 then 'low'
    when score between 1 and 1 then 'low-intermediate'
    when score between 2 and 2 then 'high-intermediate'
    when score between 3 and 3 then 'high'
    else null
  end

define "aaIPI_Score":
  if ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AgeGroupKnown" and "AgeGroupValue" in { 'age-le-60' })
    and "DlbclStageKnown"
    and "SerumLdhKnown"
    and "EcogPsKnown"
    then Calculate_aaIPI("DlbclStageValue", "SerumLdhValue", "EcogPsValue")
    else null

define "aaIPI_RiskGroup":
  Classify_aaIPI("aaIPI_Score")

define "aaIPI_RiskLabel":
  case "aaIPI_RiskGroup"
    when 'low' then 'Low Risk (Score 0: ~83% 5-year OS)'
    when 'low-intermediate' then 'Low-Intermediate Risk (Score 1: ~69% 5-year OS)'
    when 'high-intermediate' then 'High-Intermediate Risk (Score 2: ~53% 5-year OS)'
    when 'high' then 'High Risk (Score 3: ~32% 5-year OS)'
    else null
  end

/* International Prognostic Index (IPI) - Full 5-factor prognostic index for DLBCL across all age groups: Age > 60 (1 pt), Stage III-IV (1 pt), elevated LDH (1 pt), ECOG >= 2 (1 pt), Extranodal > 1 site (1 pt). Max: 5. */
define function Calculate_IPI(ageGroup String, dlbclStage String, serumLdh String, ecogPs String, extranodalSites String) returns Integer:
  (case ageGroup when 'age-gt-60' then 1 else 0 end)
    + (case dlbclStage when 'stage-3-4-advanced' then 1 else 0 end)
    + (case serumLdh when 'ldh-elevated' then 1 else 0 end)
    + (case ecogPs when 'ecog-2-4' then 1 else 0 end)
    + (case extranodalSites when 'extranodal-gt-1' then 1 else 0 end)

define function Classify_IPI(score Integer) returns String:
  case
    when score between 0 and 1 then 'low'
    when score between 2 and 2 then 'low-intermediate'
    when score between 3 and 3 then 'high-intermediate'
    when score between 4 and 5 then 'high'
    else null
  end

define "IPI_Score":
  if ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and "AgeGroupKnown"
    and "DlbclStageKnown"
    and "SerumLdhKnown"
    and "EcogPsKnown"
    and "ExtranodalSitesKnown"
    then Calculate_IPI("AgeGroupValue", "DlbclStageValue", "SerumLdhValue", "EcogPsValue", "ExtranodalSitesValue")
    else null

define "IPI_RiskGroup":
  Classify_IPI("IPI_Score")

define "IPI_RiskLabel":
  case "IPI_RiskGroup"
    when 'low' then 'Low Risk (Score 0-1: ~82% 5-year OS)'
    when 'low-intermediate' then 'Low-Intermediate Risk (Score 2: ~67% 5-year OS)'
    when 'high-intermediate' then 'High-Intermediate Risk (Score 3: ~55% 5-year OS)'
    when 'high' then 'High Risk (Score 4-5: ~40% 5-year OS)'
    else null
  end

/* ---- Rules (evaluated in order; first match wins) ---- */
/* Lymphoma subtype or stage unknown */
define "Rule1_LymphomaSubtypeOrStageUnknown":
  not "LymphomaSubtypeKnown"

/* DLBCL stage or fitness unknown */
define "Rule2_DlbclStageOrFitnessUnknown":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and not "DlbclStageKnown"

/* Anthracycline fitness unknown */
define "Rule3_AnthracyclineFitnessUnknown":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and not "AnthracyclineFitnessKnown"

/* Cardiotoxicity gate: LVEF decline > 10% on therapy */
define "Rule4_CardiotoxicityGateLvefDecline10OnTherapy":
  ("CardiacEchoStatusKnown" and "CardiacEchoStatusValue" in { 'echo-lvef-declined' })

/* PMBCL with central venous access: DA-EPOCH-R */
define "Rule5_PmbclWithCentralVenousAccessDaEpochR":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'pmbcl' })
    and ("CentralVenousAccessKnown" and "CentralVenousAccessValue" in { 'central-access-available' })

/* PMBCL without central venous access: R-CHOP alternative */
define "Rule6_PmbclWithoutCentralVenousAccessRChopAlte":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'pmbcl' })
    and ("CentralVenousAccessKnown" and "CentralVenousAccessValue" in { 'no-central-access' })

/* HIV+ DLBCL with CD4 >= 50: SC-RR-EPOCH with Rituximab */
define "Rule7_HivDlbclWithCd450ScRrEpochWithRituximab":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("ViralScreeningHivKnown" and "ViralScreeningHivValue" in { 'hiv-positive' })
    and ("Cd4CountKnown" and "Cd4CountValue" in { 'cd4-gte-50' })

/* HIV+ DLBCL with CD4 < 50: EPOCH without Rituximab */
define "Rule8_HivDlbclWithCd450EpochWithoutRituximab":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("ViralScreeningHivKnown" and "ViralScreeningHivValue" in { 'hiv-positive' })
    and ("Cd4CountKnown" and "Cd4CountValue" in { 'cd4-lt-50' })

/* Cardiac dysfunction: R-CEOP non-anthracycline regimen */
define "Rule9_CardiacDysfunctionRCeopNonAnthracyclineR":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'unfit-cardiac' })

/* Elderly with frailty (curative intent): R-miniCHOP */
define "Rule10_ElderlyWithFrailtyCurativeIntentRMinicho":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'unfit-elderly-frail' })

/* Anthracycline ineligible: R-GCVP gemcitabine regimen */
define "Rule11_AnthracyclineIneligibleRGcvpGemcitabineR":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'unfit-anthra-ineligible' })

/* Frail / Palliative intent: BR or R-PEP-C */
define "Rule12_FrailPalliativeIntentBrOrRPepC":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'frail-palliative' })

/* High CNS relapse risk sites: IT + HD-MTX prophylaxis */
define "Rule13_HighCnsRelapseRiskSitesItHdMtxProphylaxi":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'fit-r-chop' })
    and ("CnsRiskSitesKnown" and "CnsRiskSitesValue" in { 'cns-high-risk' })

/* Limited stage aaIPI 0, non-bulky: PET-adapted R-CHOP x 3-4 */
define "Rule14_LimitedStageAaipi0NonBulkyPetAdaptedRCho":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'fit-r-chop' })
    and ("DlbclStageKnown" and "DlbclStageValue" in { 'stage-1-2-limited' })
    and ("BulkyStatusKnown" and "BulkyStatusValue" in { 'non-bulky' })
    and ("aaIPI_RiskGroup" in { 'low' })

/* Limited stage with bulky disease (>= 7.5 cm): R-CHOP x 6 + IFRT */
define "Rule15_LimitedStageWithBulkyDisease75CmRChopX6I":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'fit-r-chop' })
    and ("DlbclStageKnown" and "DlbclStageValue" in { 'stage-1-2-limited' })
    and ("BulkyStatusKnown" and "BulkyStatusValue" in { 'bulky-gte-7-5cm' })

/* Limited stage with aaIPI >= 1: R-CHOP x 6 + IFRT */
define "Rule16_LimitedStageWithAaipi1RChopX6Ifrt":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'fit-r-chop' })
    and ("DlbclStageKnown" and "DlbclStageValue" in { 'stage-1-2-limited' })
    and ("aaIPI_RiskGroup" in { 'low-intermediate', 'high-intermediate', 'high' })

/* Advanced Non-GCB DLBCL (IPI >= 2, Age < 70, non-bulky): Pola-R-CHP */
define "Rule17_AdvancedNonGcbDlbclIpi2Age70NonBulkyPola":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'fit-r-chop' })
    and ("DlbclStageKnown" and "DlbclStageValue" in { 'stage-3-4-advanced' })
    and ("CellOfOriginKnown" and "CellOfOriginValue" in { 'non-gcb' })
    and ("BulkyStatusKnown" and "BulkyStatusValue" in { 'non-bulky' })
    and ("IPI_RiskGroup" in { 'low-intermediate', 'high-intermediate', 'high' })

/* Advanced stage DLBCL fit: Standard R-CHOP x 6 */
define "Rule18_AdvancedStageDlbclFitStandardRChopX6":
  ("LymphomaSubtypeKnown" and "LymphomaSubtypeValue" in { 'dlbcl' })
    and ("AnthracyclineFitnessKnown" and "AnthracyclineFitnessValue" in { 'fit-r-chop' })
    and ("DlbclStageKnown" and "DlbclStageValue" in { 'stage-3-4-advanced' })

/* ---- Treatment group ---- */
define "TreatmentGroup":
  case
    when "Rule1_LymphomaSubtypeOrStageUnknown" then 'needs-review'
    when "Rule2_DlbclStageOrFitnessUnknown" then 'needs-review'
    when "Rule3_AnthracyclineFitnessUnknown" then 'needs-review'
    when "Rule4_CardiotoxicityGateLvefDecline10OnTherapy" then 'cardiotoxicity-switch'
    when "Rule5_PmbclWithCentralVenousAccessDaEpochR" then 'pmbcl-fit-central-access'
    when "Rule6_PmbclWithoutCentralVenousAccessRChopAlte" then 'pmbcl-alternative-rchop'
    when "Rule7_HivDlbclWithCd450ScRrEpochWithRituximab" then 'dlbcl-hiv-cd4-gte-50'
    when "Rule8_HivDlbclWithCd450EpochWithoutRituximab" then 'dlbcl-hiv-cd4-lt-50'
    when "Rule9_CardiacDysfunctionRCeopNonAnthracyclineR" then 'dlbcl-unfit-cardiac-ceop'
    when "Rule10_ElderlyWithFrailtyCurativeIntentRMinicho" then 'dlbcl-unfit-elderly-minichop'
    when "Rule11_AnthracyclineIneligibleRGcvpGemcitabineR" then 'dlbcl-unfit-anthra-ineligible-gcvp'
    when "Rule12_FrailPalliativeIntentBrOrRPepC" then 'dlbcl-frail-palliative'
    when "Rule13_HighCnsRelapseRiskSitesItHdMtxProphylaxi" then 'dlbcl-high-cns-risk-prophylaxis'
    when "Rule14_LimitedStageAaipi0NonBulkyPetAdaptedRCho" then 'dlbcl-fit-limited-aai0-nonbulky'
    when "Rule15_LimitedStageWithBulkyDisease75CmRChopX6I" then 'dlbcl-fit-limited-aai1-or-bulky'
    when "Rule16_LimitedStageWithAaipi1RChopX6Ifrt" then 'dlbcl-fit-limited-aai1-or-bulky'
    when "Rule17_AdvancedNonGcbDlbclIpi2Age70NonBulkyPola" then 'dlbcl-fit-advanced-pola-r-chp'
    when "Rule18_AdvancedStageDlbclFitStandardRChopX6" then 'dlbcl-fit-advanced-standard'
    else 'needs-review'
  end

/* ---- Recommended regimens ---- */
define "RecommendedRegimens":
  case "TreatmentGroup"
    when 'cardiotoxicity-switch' then { 'Urgent Cardiology referral & cardioprotective optimization', 'Discontinue Doxorubicin -> Switch to R-CEOP (Etoposide replaces Doxorubicin)', 'Alternative: R-GCVP / R-CGOP (Gemcitabine based)' }
    when 'dlbcl-high-cns-risk-prophylaxis' then { 'R-CHOP x 6 cycles q21d', 'Intrathecal Methotrexate (12 mg) with each chemotherapy cycle', 'High-Dose Methotrexate (3.0-3.5 g/m2) x 2 cycles after cycle 6 (DTPA GFR > 60 required)', 'Consider prophylactic radiation to both testes if testicular involvement' }
    when 'dlbcl-hiv-cd4-gte-50' then { 'SC-RR-EPOCH (short-course dose-dense infusional EPOCH with Rituximab)', 'Optimized combination Antiretroviral Therapy (ART) continuation', 'Opportunistic infection prophylaxis (TMP-SMX for PCP + fungal prophylaxis)', 'Interim PET-CT after cycle 2 (if CMR -> 1 more cycle, total 3; if not CMR -> 3rd cycle)' }
    when 'dlbcl-hiv-cd4-lt-50' then { 'Infusional EPOCH without Rituximab (Rituximab avoided due to CD4 < 50)', 'Aggressive ART optimization & viral load monitoring', 'Mandatory multi-pathogen opportunistic infection prophylaxis', 'Re-assess CD4 count after ART response before subsequent therapy decisions' }
    when 'dlbcl-fit-limited-aai0-nonbulky' then { 'R-CHOP x 3 cycles (Rituximab, Cyclophosphamide, Doxorubicin, Vincristine, Prednisone)', 'Interim 18F-FDG PET-CT after cycle 3', 'If PET CMR: +1 more R-CHOP cycle (total 4 cycles, no radiation)', 'If PET positive: 3 more R-CHOP cycles OR 30-35 Gy IFRT' }
    when 'dlbcl-fit-limited-aai1-or-bulky' then { 'R-CHOP x 6 cycles q21d', 'Involved-Field Radiotherapy (IFRT) 30-35 Gy to initial bulky disease site(s)', 'Mandatory 2D-ECHO after cycle 4 to monitor LVEF' }
    when 'dlbcl-fit-advanced-pola-r-chp' then { 'Polatuzumab vedotin (1.8 mg/kg) + R-CHP x 6 cycles q21d', 'Rituximab monotherapy (375 mg/m2) x 2 additional doses', 'Pegylated G-CSF primary prophylaxis 24h post-chemotherapy', 'End-of-treatment (EOT) 18F-FDG PET-CT assessment' }
    when 'dlbcl-fit-advanced-standard' then { 'R-CHOP x 6 cycles q21d', '2D-ECHO mandatory after cycle 4 to screen for cardiotoxicity', 'End-of-treatment (EOT) PET-CT assessment', 'Consolidative RT 30-35 Gy if PR with uptake at single residual site' }
    when 'dlbcl-unfit-cardiac-ceop' then { 'R-CEOP x 6 cycles (Rituximab, Cyclophosphamide, Etoposide, Vincristine, Prednisone)', 'Prophylactic G-CSF support', 'End-of-treatment PET-CT response evaluation' }
    when 'dlbcl-unfit-elderly-minichop' then { 'R-miniCHOP x 6 cycles q21d (attenuated doses + full-dose Rituximab 375 mg/m2)', 'Pre-phase Cyclophosphamide + Prednisone x 7 days prior to cycle 1', 'Mandatory Pegylated G-CSF support in all cycles' }
    when 'dlbcl-unfit-anthra-ineligible-gcvp' then { 'R-GCVP x 6 cycles (Rituximab, Gemcitabine, Cyclophosphamide, Vincristine, Prednisone)', 'G-CSF prophylaxis' }
    when 'dlbcl-frail-palliative' then { 'Bendamustine + Rituximab (BR) attenuated / palliative intent', 'Oral metronomic R-PEP-C (Prednisone, Etoposide, Procarbazine, Cyclophosphamide + Rituximab)', 'Radiotherapy alone if Stage I-II disease coverable in limited radiation field' }
    when 'pmbcl-fit-central-access' then { 'DA-EPOCH-R x 6 cycles (continuous 96-hr infusional etoposide, doxorubicin, vincristine + bolus cyclophosphamide & rituximab)', 'CBC on Days 8, 10, and 12 of each cycle to calculate pharmacodynamic dose adjustment', 'Mandatory prophylactic G-CSF in every cycle', 'Interim PET-CT at cycle 4 and End-of-Treatment PET-CT at cycle 6' }
    when 'pmbcl-alternative-rchop' then { 'R-CHOP x 6 cycles q21d', 'Interim PET-CT at cycle 4', 'Consolidative RT to mediastinum if interim PET positive (DS 4-5)' }
    else { }
  end

/* ---- Advanced custom CQL definitions ---- */
/* Step 8 G-CSF Prophylaxis Gate: mandatory in R-CHOP if age > 55 or prior Gr 3/4 toxicity; mandatory in all DA-EPOCH-R or SC-RR-EPOCH cycles */
define function Requires_GCSF_Prophylaxis(regimen String, ageGroup String, priorToxicity Boolean) returns Boolean:
  priorToxicity = true or ageGroup in { 'age-gt-60' } or regimen in { 'DA-EPOCH-R', 'SC-RR-EPOCH' }

/* Step 9 Cardiac Monitoring Gate: repeat 2D-ECHO mandatory after cycle 4 in all patients receiving anthracycline therapy */
define function Mandatory_Cardiac_Echo_C4(cyclesCompleted Integer, baselineLvef Decimal) returns Boolean:
  cyclesCompleted >= 4 and baselineLvef is not null

/* Step 6 Pre-Phase Gate: mandatory Cyclophosphamide + Steroids in elderly Stage III/IV, bulky, GI disease, or poor PS */
define function Requires_Prephase_Therapy(stage String, isElderly Boolean, isBulky Boolean, hasGiInvolvement Boolean, ecog Integer) returns Boolean:
  (isElderly and stage in { 'stage-3-4-advanced' }) or isBulky = true or hasGiInvolvement = true or ecog >= 2
